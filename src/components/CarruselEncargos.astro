---
// Carrusel automático de encargos ya hechos (todas las categorías), un paso cada 2 s. Cada tarjeta lleva a la ficha del
// personalizado de su categoría, para pedir uno así. Pasa solo cada pocos segundos, se para con el ratón,
// el foco o el dedo encima, y tiene botones de anterior, pausa y siguiente.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { idiomaDe, traductor } from '../i18n';

interface Item { nombre: string; tipo: string; src: ImageMetadata; href: string }
interface Props { items: Item[]; titulo: string; texto: string }
const { items, titulo, texto } = Astro.props;
const t = traductor(idiomaDe(Astro.url));
const cta = t('Pide el tuyo', 'Order yours', 'Commandez le vôtre');
---
{items.length > 0 && (
  <section class="section enc" aria-labelledby="enc-h">
    <div class="wrap">
      <div class="enc__head">
        <div class="enc__txt">
          <h2 id="enc-h">{titulo}</h2>
          <p>{texto}</p>
        </div>
        <div class="enc__ctrl">
          <button type="button" class="icon-btn" data-enc-prev aria-label={t('Anterior', 'Previous', 'Précédent')}><Icon name="izq" /></button>
          <button type="button" class="icon-btn" data-enc-pausa aria-pressed="false" data-pausar={t('Pausar el carrusel', 'Pause the carousel', 'Mettre le carrousel en pause')} data-reanudar={t('Reanudar el carrusel', 'Resume the carousel', 'Relancer le carrousel')} aria-label={t('Pausar el carrusel', 'Pause the carousel', 'Mettre le carrousel en pause')}>
            <svg data-ico-pausa width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.5" height="14" rx="1"/><rect x="14" y="5" width="3.5" height="14" rx="1"/></svg>
            <svg data-ico-play hidden width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"/></svg>
          </button>
          <button type="button" class="icon-btn" data-enc-next aria-label={t('Siguiente', 'Next', 'Suivant')}><Icon name="der" /></button>
        </div>
      </div>
      <ul class="enc__track" data-enc aria-label={titulo}>
        {items.map((it) => (
          <li class="enc__item">
            <a class="enc__card" href={it.href} aria-label={t(`${it.nombre}: pide uno así`, `${it.nombre}: order one like this`, `${it.nombre} : commandez le même`)}>
              <span class="enc__media">
                <Picture src={it.src} alt="" formats={['avif', 'webp']} widths={[240, 360, 480]} sizes="(min-width: 1024px) 23vw, 44vw" loading="lazy" />
                <span class="enc__tipo">{it.tipo}</span>
              </span>
              <span class="enc__nombre">{it.nombre}</span>
              <span class="enc__cta">{cta} <Icon name="flecha" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .enc { padding-top: 0; }
  .enc__head { display: flex; justify-content: space-between; align-items: end; gap: var(--s-4); margin-bottom: var(--s-5); }
  .enc__txt { display: grid; gap: var(--s-2); }
  .enc__txt p { color: var(--muted); }
  .enc__ctrl { display: flex; gap: var(--s-1); flex: none; }
  .enc__ctrl .icon-btn { border: 1px solid var(--line-strong); border-radius: 50%; }
  .enc__track {
    list-style: none; padding: 0; margin: 0; display: grid; grid-auto-flow: column; gap: var(--s-4);
    grid-auto-columns: calc((100% - var(--s-4)) / 2.2);
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain;
  }
  .enc__track::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) { .enc__track { grid-auto-columns: calc((100% - 2 * var(--s-4)) / 3); } }
  @media (min-width: 1024px) { .enc__track { grid-auto-columns: calc((100% - 3 * var(--s-4)) / 4); } }
  .enc__item { scroll-snap-align: start; }
  .enc__card { display: grid; gap: var(--s-2); text-decoration: none; }
  .enc__media { position: relative; display: block; aspect-ratio: 3 / 4; border-radius: var(--r-md); overflow: hidden; background: var(--surface); transition: transform 240ms var(--ease-out), box-shadow 240ms var(--ease-out); }
  .enc__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease-out); }
  .enc__tipo { position: absolute; left: 10px; top: 10px; padding: 4px 10px; border-radius: var(--r-pill); background: rgb(247 243 236 / 0.92); font-size: 0.8125rem; font-weight: 560; }
  .enc__nombre { font-weight: 560; font-size: 1.0625rem; line-height: 1.35; }
  .enc__cta { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 560; font-size: 0.9375rem; }
  .enc__card:focus-visible { outline: none; }
  .enc__card:focus-visible .enc__media { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) {
    .enc__card:hover .enc__media { transform: translateY(-2px); box-shadow: var(--shadow-1); }
    .enc__card:hover .enc__media :global(img) { transform: scale(1.03); }
  }
  @media (max-width: 559px) { .enc__ctrl .icon-btn:not([data-enc-pausa]) { display: none; } }
</style>

<script>
  const reducido = matchMedia('(prefers-reduced-motion: reduce)');
  const INTERVALO = 2000;

  document.querySelectorAll<HTMLElement>('[data-enc]').forEach((track) => {
    const sec = track.closest('section')!;
    const btnPausa = sec.querySelector<HTMLButtonElement>('[data-enc-pausa]')!;
    let timer = 0, pausado = reducido.matches, encima = false, enPantalla = false;

    const paso = () => {
      const item = track.querySelector<HTMLElement>('.enc__item');
      return item ? item.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : track.clientWidth;
    };
    const mover = (dir: 1 | -1) => {
      const fin = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      const inicio = track.scrollLeft <= 4;
      const suave = reducido.matches ? 'auto' : 'smooth';
      if (dir === 1 && fin) track.scrollTo({ left: 0, behavior: suave });
      else if (dir === -1 && inicio) track.scrollTo({ left: track.scrollWidth, behavior: suave });
      else track.scrollBy({ left: dir * paso(), behavior: suave });
    };
    const parar = () => { clearInterval(timer); timer = 0; };
    const arrancar = () => {
      parar();
      if (pausado || encima || !enPantalla || document.hidden) return;
      timer = window.setInterval(() => mover(1), INTERVALO);
    };
    const pintarPausa = () => {
      btnPausa.setAttribute('aria-pressed', String(pausado));
      btnPausa.setAttribute('aria-label', (pausado ? btnPausa.dataset.reanudar : btnPausa.dataset.pausar) ?? '');
      btnPausa.querySelector('[data-ico-pausa]')!.toggleAttribute('hidden', pausado);
      btnPausa.querySelector('[data-ico-play]')!.toggleAttribute('hidden', !pausado);
    };

    new IntersectionObserver(([e]) => { enPantalla = e.isIntersecting; arrancar(); }, { threshold: 0.3 }).observe(track);
    sec.querySelector('[data-enc-prev]')!.addEventListener('click', () => { mover(-1); arrancar(); });
    sec.querySelector('[data-enc-next]')!.addEventListener('click', () => { mover(1); arrancar(); });
    btnPausa.addEventListener('click', () => { pausado = !pausado; pintarPausa(); arrancar(); });
    track.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { encima = true; parar(); } });
    track.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { encima = false; arrancar(); } });
    track.addEventListener('focusin', () => { encima = true; parar(); });
    track.addEventListener('focusout', (e) => { if (!track.contains(e.relatedTarget as Node)) { encima = false; arrancar(); } });
    track.addEventListener('touchstart', () => { encima = true; parar(); }, { passive: true });
    track.addEventListener('touchend', () => setTimeout(() => { encima = false; arrancar(); }, 2500), { passive: true });
    document.addEventListener('visibilitychange', arrancar);
    reducido.addEventListener('change', () => { if (reducido.matches) { pausado = true; pintarPausa(); parar(); } });

    pintarPausa();
    arrancar();
  });
</script>
