---
import { Picture } from 'astro:assets';
import { foto, fotoAmbiente, catalogoEn, type Producto } from '../lib/catalogo';
import { idiomaDe } from '../i18n';
interface Props { p: Producto; prioridad?: boolean; mostrarCategoria?: boolean; nivel?: 'h2' | 'h3' }
const { prioridad = false, mostrarCategoria = true, nivel = 'h3' } = Astro.props;
const C = catalogoEn(idiomaDe(Astro.url));
const p = C.loc(Astro.props.p);
// El Funko personalizado no enseña un encargo real: enseña lo que incluye el precio base (la caja con un Funko normal)
const f = p.slug === 'funko-personalizado'
  ? { src: fotoAmbiente('funko-caja-1.png'), alt: C.t('Dibujo de la caja a medida con un Funko normal', 'Drawing of the made-to-measure box with one regular Funko', 'Dessin de la boîte sur mesure avec un Funko normal') }
  : foto(p);
const Tag = nivel;
const cat = C.categoria(p.categoria);
const etiqueta = p.personalizacion.disponible
  ? C.t('Personalizable', 'Customisable', 'Personnalisable')
  : p.etiquetas.includes('edicion-especial') ? C.t('Edición especial', 'Special edition', 'Édition spéciale') : null;
---
<article class="card">
  <div class="card__media">
    <Picture
      src={f.src}
      alt={f.alt}
      formats={['avif', 'webp']}
      widths={[240, 360, 480, 720]}
      sizes="(min-width: 1280px) 300px, (min-width: 768px) 30vw, 46vw"
      loading={prioridad ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : undefined}
    />
    {etiqueta && <span class="card__tag">{etiqueta}</span>}
  </div>
  <div class="card__body">
    {mostrarCategoria && cat && <span class="card__cat">{cat.nombre}</span>}
    <Tag class="card__title"><a href={C.urlProducto(p)}>{p.nombre}</a></Tag>
    <span class:list={['card__price precio', { 'card__price--consultar': p.precio.tipo === 'consultar' }]}>{C.textoPrecio(p)}</span>
  </div>
</article>
