---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" description="Esta página no existe. Vuelve al catálogo." noindex>
  <div class="wrap page-head" style="padding-block: var(--s-9)">
    <h1>Esta página no existe</h1>
    <p class="lead">Puede que la pieza ya no esté en el catálogo o que el enlace tenga una errata.</p>
    <div class="btn-row"><a class="btn" href="/catalogo">Ir al catálogo</a><a class="btn btn--secondary" href="/">Volver al inicio</a></div>
  </div>
</Base>
