---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { categorias } from '../../lib/catalogo';
import { ESTADOS } from '../../lib/estados';
const cats = categorias.filter((c) => c.slug !== 'encargos').map((c) => ({ slug: c.slug, nombre: c.nombre }));
---
<Base title="Panel de administración" description="Panel privado de Daniro 3D." noindex manifest="/admin.webmanifest">
  <div class="wrap admin" data-admin>
    <script type="application/json" data-config set:html={JSON.stringify({ cats, estados: ESTADOS })} />

    <div class="admin__head">
      <h1>Panel</h1>
      <div class="admin__user" data-user hidden>
        <span data-user-email></span>
        <button class="btn btn--secondary btn--sm" type="button" data-salir><Icon name="salir" />Salir</button>
      </div>
    </div>

    <p class="aviso" data-estado-carga>Cargando…</p>
    <p class="aviso" data-sin-firebase hidden>Firebase no está configurado: faltan las variables <code>PUBLIC_FIREBASE_*</code>.</p>

    <!-- Login -->
    <form class="tarjeta login" data-login hidden novalidate>
      <h2>Entrar</h2>
      <div class="field"><label for="l-email">Email</label><input class="input" id="l-email" name="email" type="email" autocomplete="email" /></div>
      <div class="field"><label for="l-pass">Contraseña</label><input class="input" id="l-pass" name="pass" type="password" autocomplete="current-password" /></div>
      <p class="error" role="alert" data-login-error></p>
      <button class="btn btn--block" type="submit">Entrar</button>
      <button class="btn btn--secondary btn--block" type="button" data-google>Entrar con Google</button>
    </form>

    <!-- Sin permiso -->
    <div class="tarjeta" data-no-admin hidden>
      <h2>Esta cuenta no es administradora</h2>
      <p>Para darle acceso, en Firebase Console → Firestore crea la colección <code>admins</code> y dentro un documento cuyo ID sea este UID (puede estar vacío):</p>
      <p class="uid"><code data-uid></code> <button class="btn btn--secondary btn--sm" type="button" data-copiar-uid>Copiar</button></p>
      <p class="nota">Después recarga esta página.</p>
    </div>

    <!-- Panel -->
    <div data-app hidden>
      <!-- Avisos de pedidos nuevos en este móvil (notificaciones) -->
      <section class="avisos" aria-labelledby="avisos-h" data-avisos>
        <div class="avisos__txt">
          <h2 id="avisos-h">Avisos de pedidos en este dispositivo</h2>
          <p class="meta" data-avisos-estado>Comprobando…</p>
        </div>
        <div class="btn-row">
          <button class="btn btn--sm" type="button" data-avisos-activar hidden>Activar avisos</button>
          <button class="btn btn--secondary btn--sm" type="button" data-avisos-probar hidden>Mandar un aviso de prueba</button>
          <button class="btn btn--secondary btn--sm" type="button" data-avisos-desactivar hidden>Desactivar aquí</button>
          <button class="btn btn--secondary btn--sm" type="button" data-instalar hidden>Instalar la app</button>
        </div>
      </section>

      <div class="tabs" role="tablist" aria-label="Secciones del panel">
        <button type="button" role="tab" aria-selected="true" data-tab="pedidos">Pedidos <span class="n" data-n-pedidos></span></button>
        <button type="button" role="tab" aria-selected="false" data-tab="encargos" tabindex="-1">Encargos <span class="n" data-n-encargos></span></button>
        <button type="button" role="tab" aria-selected="false" data-tab="productos" tabindex="-1">Productos <span class="n" data-n-productos></span></button>
        <button type="button" role="tab" aria-selected="false" data-tab="publicar" tabindex="-1">Publicar</button>
      </div>

      <section role="tabpanel" data-panel="pedidos" aria-label="Pedidos">
        <div class="barra">
          <label class="field-inline">Estado
            <select class="select" data-filtro-pedidos><option value="">Todos</option>{ESTADOS.map((e) => <option value={e.id}>{e.txt}</option>)}</select>
          </label>
          <label class="field-inline">Tipo
            <select class="select" data-tipo-pedidos><option value="">Todos</option><option value="catalogo">Del catálogo</option><option value="personalizado">Personalizados</option></select>
          </label>
          <span class="meta">Se actualiza solo. Lo que cambies aquí lo ve el cliente en "Mi cuenta".</span>
        </div>
        <ul class="items" data-lista-pedidos></ul>
      </section>

      <section role="tabpanel" data-panel="encargos" aria-label="Encargos" hidden>
        <div class="barra">
          <label class="field-inline">Estado
            <select class="select" data-filtro-encargos><option value="">Todos</option>{ESTADOS.map((e) => <option value={e.id}>{e.txt}</option>)}</select>
          </label>
          <span class="meta">Encargos a medida del formulario. Los Funkos personalizados están en Pedidos.</span>
        </div>
        <ul class="items" data-lista-encargos></ul>
      </section>

      <section role="tabpanel" data-panel="productos" aria-label="Productos" hidden>
        <div class="barra">
          <input class="input" type="search" placeholder="Buscar producto" data-buscar-producto aria-label="Buscar producto" />
          <button class="btn btn--sm" type="button" data-nuevo><Icon name="mas" size={18} />Nuevo producto</button>
        </div>
        <div class="tarjeta importar" data-importar hidden>
          <h2>Firestore todavía no tiene productos</h2>
          <p>Pulsa aquí una sola vez para traer el catálogo actual (todos los productos y Funkos hechos de la web, con sus textos, precios y fotos) y empezar a editarlo desde el panel.</p>
          <button class="btn" type="button" data-importar-btn>Importar el catálogo actual</button>
        </div>
        <div class="tarjeta cambios" data-cambios hidden role="status">
          <p data-cambios-txt>Cambios guardados. Para que salgan en la web, publícalos (tarda 1–3 minutos).</p>
          <button class="btn btn--sm" type="button" data-publicar>Publicar ahora</button>
        </div>
        <p class="nota">Los cambios se guardan al momento, pero la web pública se actualiza cuando pulsas <strong>Publicar</strong>.</p>
        <ul class="productos" data-lista-productos></ul>
      </section>

      <section role="tabpanel" data-panel="publicar" aria-label="Publicar" hidden>
        <div class="tarjeta publicar">
          <h2>Publicar los cambios en la web</h2>
          <p>Vercel vuelve a generar la web con los productos de Firestore. Tarda 1–3 minutos.</p>
          <button class="btn" type="button" data-publicar>Publicar ahora</button>
          <p class="ok" role="status" data-publicar-estado></p>
          <details>
            <summary>Configurar (una sola vez)</summary>
            <p>En Vercel: <em>Project → Settings → Git → Deploy Hooks</em>, crea uno para la rama <code>main</code> y pega aquí su URL.</p>
            <div class="field"><label for="hook">URL del Deploy Hook</label><input class="input" id="hook" type="url" placeholder="https://api.vercel.com/v1/integrations/deploy/…" data-hook /></div>
            <button class="btn btn--secondary btn--sm" type="button" data-guardar-hook>Guardar</button>
          </details>
        </div>
      </section>
    </div>

    <!-- Editor de producto -->
    <dialog class="editor" data-editor aria-labelledby="ed-h">
      <form data-form-producto novalidate>
        <div class="editor__head">
          <h2 id="ed-h" data-ed-titulo>Producto</h2>
          <button class="icon-btn" type="button" data-cerrar-editor aria-label="Cerrar"><Icon name="cerrar" /></button>
        </div>
        <div class="editor__body">
          <div class="g2">
            <div class="field"><label for="p-nombre">Nombre</label><input class="input" id="p-nombre" name="nombre" required /></div>
            <div class="field"><label for="p-slug">Slug (URL)</label><input class="input" id="p-slug" name="slug" pattern="[a-z0-9\-]+" required /><p class="hint">Solo minúsculas, números y guiones. No se puede cambiar después.</p></div>
          </div>
          <div class="g2">
            <div class="field"><label for="p-cat">Categoría</label><select class="select" id="p-cat" name="categoria">{cats.map((c) => <option value={c.slug}>{c.nombre}</option>)}</select></div>
            <div class="field"><label for="p-fecha">Fecha de alta</label><input class="input" id="p-fecha" name="fechaAlta" type="date" /></div>
          </div>
          <div class="field"><label for="p-corta">Descripción corta</label><input class="input" id="p-corta" name="descripcionCorta" maxlength="160" /></div>
          <div class="field"><label for="p-larga">Descripción larga</label><textarea class="textarea" id="p-larga" name="descripcionLarga" rows="4"></textarea></div>

          <fieldset class="g3">
            <legend>Precio</legend>
            <div class="field"><label for="p-ptipo">Tipo</label><select class="select" id="p-ptipo" name="precioTipo"><option value="fijo">Fijo</option><option value="desde">Desde</option><option value="consultar">A consultar</option></select></div>
            <div class="field"><label for="p-pimp">Importe (€)</label><input class="input" id="p-pimp" name="precioImporte" type="number" min="0" step="0.5" /></div>
            <div class="field"><label for="p-puni">Unidad</label><input class="input" id="p-puni" name="precioUnidad" placeholder="ud." /></div>
          </fieldset>
          <div class="field"><label for="p-var">Tamaños con precio propio</label><textarea class="textarea" id="p-var" name="variantes" rows="2" placeholder={'30 cm = 30\n15 cm = consultar'}></textarea><p class="hint">Uno por línea: nombre = precio (o "consultar"). Vacío si no tiene.</p></div>

          <div class="g2">
            <div class="field"><label for="p-mat">Materiales</label><input class="input" id="p-mat" name="materiales" placeholder="PLA, PETG" /></div>
            <div class="field"><label for="p-col">Colores</label><input class="input" id="p-col" name="colores" placeholder="Rojo, Negro" /></div>
          </div>
          <div class="g2">
            <div class="field"><label for="p-dim">Medidas</label><input class="input" id="p-dim" name="dimensiones" placeholder="25 cm de alto" /></div>
            <div class="field"><label for="p-tiempo">Tiempo de fabricación</label><input class="input" id="p-tiempo" name="tiempoFabricacion" placeholder="5–7 días" /></div>
          </div>
          <div class="g2">
            <div class="field"><label for="p-tags">Etiquetas</label><input class="input" id="p-tags" name="etiquetas" placeholder="futbol, regalo" /></div>
            <div class="field"><label for="p-comp">Composición (solo Funkos)</label><input class="input" id="p-comp" name="composicion" placeholder="Caja + 1 normal + 2 pequeños" /></div>
          </div>
          <div class="field"><label for="p-pnotas">Notas de personalización</label><input class="input" id="p-pnotas" name="persNotas" placeholder="Qué tiene que mandar el cliente" /></div>
          <div class="checks">
            <label class="check"><input type="checkbox" name="persDisponible" /> Personalizable</label>
            <label class="check"><input type="checkbox" name="destacado" /> Destacado</label>
            <label class="check"><input type="checkbox" name="colorAElegir" /> El cliente elige color</label>
            <label class="check"><input type="checkbox" name="ejemplo" /> Encargo hecho (solo galería, no se vende)</label>
          </div>

          <fieldset class="fotos">
            <legend>Fotos</legend>
            <ul class="fotos__lista" data-fotos></ul>
            <label class="btn btn--secondary btn--sm subir"><Icon name="subir" size={18} />Subir fotos<input type="file" accept="image/*" multiple data-subir hidden /></label>
            <p class="hint" data-subir-estado>La primera foto es la portada. JPG o PNG, mejor de 1500 px o más.</p>
          </fieldset>
          <p class="error" role="alert" data-ed-error></p>
        </div>
        <div class="editor__foot">
          <button class="btn btn--secondary" type="button" data-borrar-producto>Borrar</button>
          <button class="btn" type="submit" data-guardar-producto>Guardar</button>
        </div>
      </form>
    </dialog>
  </div>
</Base>

<style>
  .admin { padding-block: var(--s-5) var(--s-9); display: grid; gap: var(--s-5); }
  .admin__head { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); flex-wrap: wrap; }
  .admin__head h1 { font-size: 2.5rem; }
  .admin__user { display: flex; align-items: center; gap: var(--s-3); color: var(--muted); font-size: var(--t-small); }
  .aviso, .nota, .hint { color: var(--muted); font-size: var(--t-small); }
  .tarjeta { display: grid; gap: var(--s-4); padding: var(--s-5); border-radius: var(--r-lg); background: var(--card); max-width: 640px; }
  .tarjeta h2 { font-size: 1.5rem; }
  .login { max-width: 420px; }
  .uid code { font-size: 1rem; padding: 4px 8px; background: var(--surface); border-radius: 6px; word-break: break-all; }
  .error { color: var(--danger); font-weight: 500; font-size: var(--t-small); }
  .error:empty, .ok:empty { display: none; }
  .ok { color: var(--accent); font-weight: 560; }
  .btn--sm { min-height: 40px; padding-inline: var(--s-4); font-size: 0.9375rem; }

  .tabs { display: flex; gap: var(--s-1); border-bottom: 1px solid var(--line-strong); overflow-x: auto; margin-bottom: var(--s-5); }
  .tabs button { min-height: 48px; padding: 0 var(--s-4); border: 0; background: none; font-weight: 560; color: var(--muted); border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; }
  .tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--ink); }
  .n { font-variant-numeric: tabular-nums; color: var(--muted); font-weight: 450; }
  .barra { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; margin-bottom: var(--s-4); }
  .barra .input { max-width: 320px; }
  .field-inline { display: inline-flex; align-items: center; gap: var(--s-2); font-weight: 560; font-size: 0.9375rem; }
  .field-inline .select { min-height: 40px; padding-block: 6px; }

  .items { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .items > :global(li) { display: grid; gap: var(--s-3); padding: var(--s-4) var(--s-5); border-radius: var(--r-md); background: var(--card); }
  .items :global(.fila) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2) var(--s-4); align-items: center; }
  .items :global(.ref) { font-weight: 600; font-variant-numeric: tabular-nums; }
  .items :global(.chip-tipo) { display: inline-block; margin-left: 6px; padding: 1px 8px; border-radius: var(--r-pill); background: var(--accent-soft); color: var(--accent); font-size: 0.75rem; font-weight: 600; vertical-align: 1px; }
  .barra .meta { color: var(--muted); font-size: var(--t-small); }
  .tarjeta.cambios { display: flex; max-width: none; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-4); border-left: 4px solid var(--accent); }
  .cambios p { font-weight: 560; }
  .avisos { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s-3) var(--s-5); margin-bottom: var(--s-5); padding: var(--s-4) var(--s-5); border-radius: var(--r-md); background: var(--card); }
  .avisos h2 { font-size: 1.125rem; }
  .avisos .meta { color: var(--muted); font-size: var(--t-small); max-width: 60ch; margin-top: 2px; }
  .avisos .meta[data-ok] { color: var(--accent); font-weight: 560; }
  .items :global(.meta) { color: var(--muted); font-size: var(--t-small); }
  .items :global(.lineas) { padding-left: 1.1em; font-size: 0.9375rem; display: grid; gap: 2px; }
  .items :global(.select) { min-height: 40px; padding-block: 6px; width: auto; }
  .items :global(.textarea) { min-height: 72px; }
  .items :global(a) { color: var(--accent); font-weight: 560; }

  .productos { list-style: none; padding: 0; display: grid; gap: var(--s-2); }
  .productos :global(li) { display: grid; grid-template-columns: 56px 1fr auto; gap: var(--s-4); align-items: center; padding: var(--s-2) var(--s-4) var(--s-2) var(--s-2); border-radius: var(--r-md); background: var(--card); }
  .productos :global(img) { width: 56px; height: 72px; object-fit: cover; border-radius: var(--r-sm); background: var(--surface); }
  .productos :global(.p-nombre) { font-weight: 560; }
  .productos :global(.p-meta) { color: var(--muted); font-size: var(--t-small); }
  .importar { max-width: none; }

  .editor { width: min(760px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); padding: 0; border: 0; border-radius: var(--r-lg); background: var(--bg); color: var(--ink); box-shadow: var(--shadow-2); }
  .editor::backdrop { background: rgb(20 22 18 / 0.5); }
  .editor form { display: grid; grid-template-rows: auto 1fr auto; max-height: calc(100dvh - 24px); }
  .editor__head, .editor__foot { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-3) var(--s-3) var(--s-5); }
  .editor__head { border-bottom: 1px solid var(--line); }
  .editor__head h2 { font-size: 1.375rem; }
  .editor__foot { border-top: 1px solid var(--line); padding: var(--s-3) var(--s-5); }
  .editor__body { overflow-y: auto; padding: var(--s-5); display: grid; gap: var(--s-4); }
  .g2, .g3 { display: grid; gap: var(--s-4); }
  @media (min-width: 640px) { .g2 { grid-template-columns: 1fr 1fr; } .g3 { grid-template-columns: 1fr 1fr 1fr; } }
  fieldset legend { font-weight: 560; margin-bottom: var(--s-2); }
  .checks { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); }
  .check { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; cursor: pointer; }
  .check input { width: 18px; height: 18px; }
  .fotos { display: grid; gap: var(--s-3); }
  .fotos__lista { list-style: none; padding: 0; display: grid; gap: var(--s-2); }
  .fotos__lista :global(li) { display: grid; grid-template-columns: 56px 1fr auto; gap: var(--s-3); align-items: center; }
  .fotos__lista :global(img) { width: 56px; height: 72px; object-fit: cover; border-radius: var(--r-sm); background: var(--surface); }
  .fotos__lista :global(.acciones) { display: flex; gap: 2px; }
  .fotos__lista :global(.acciones button) { width: 40px; height: 40px; border: 1px solid var(--line-strong); border-radius: var(--r-sm); background: var(--card); }
  .subir { justify-self: start; cursor: pointer; }
</style>

<script>
  import '../../scripts/admin';
</script>
