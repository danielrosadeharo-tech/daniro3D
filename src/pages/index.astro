---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { foto, fotoAmbiente, enlaceWhatsApp, sitio, catalogoEn } from '../lib/catalogo';
import { idiomaDe } from '../i18n';
import { FUNKO, precioFunko, resumenFunko, svgCaja } from '../lib/funko';

const C = catalogoEn(idiomaDe(Astro.url));
const t = C.t;
const destacados = C.productos
  .filter((p) => p.slug !== 'estanteria-stranger-things') // ya sale en el cierre
  .toSorted((a, b) => Number(b.destacado) - Number(a.destacado) || b.fechaAlta.localeCompare(a.fechaAlta))
  .slice(0, 8);
const pilotos = fotoAmbiente('coleccion-pilotos.jpg');
const funkoDetalle = foto(C.producto('perruno-17')!, 3);
const posavasos = foto(C.producto('posavasos-mascotas')!, 0);
// Fotos de Funkos ya hechos para la tira del inicio (la boda primero)
const funkosHechos = C.ejemplos
  .filter((e) => e.categoria === 'funkos')
  .toSorted((a, b) => Number(b.slug === 'boda-27') - Number(a.slug === 'boda-27'));
const tira = funkosHechos.slice(0, 4).map((e) => foto(e));
const estanteria = foto(C.producto('estanteria-stranger-things')!, 0);
// Precios del Funko personalizado: salen de src/lib/funko.ts (FUNKO)
const eBase = C.euros(FUNKO.base), ePequeno = C.euros(FUNKO.pequeno);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: sitio.marca,
  url: sitio.dominio,
  sameAs: [sitio.wallapop, sitio.vinted],
  contactPoint: { '@type': 'ContactPoint', telephone: `+${sitio.whatsapp}`, contactType: 'customer service', availableLanguage: ['es', 'en', 'fr'] },
};
---
<Base
  title={t(`${sitio.marca} · Funkos personalizados, figuras y regalos impresos en 3D`, `${sitio.marca} · Custom Funkos, figures and 3D-printed gifts`, `${sitio.marca} · Funkos personnalisés, figurines et cadeaux imprimés en 3D`)}
  description={t(
    `Funkos personalizados con su caja desde ${eBase}, figuras de pilotos de 30 cm, posavasos de tu mascota, llaveros y trofeos impresos en 3D bajo pedido. Pide por WhatsApp.`,
    `Custom Funkos with their box from ${eBase}, 30 cm racing driver figures, pet coasters, keyrings and trophies, 3D-printed to order. Order on WhatsApp.`,
    `Funkos personnalisés avec leur boîte dès ${eBase}, figurines de pilotes de 30 cm, sous-verres de votre animal, porte-clés et trophées imprimés en 3D sur commande. Commandez sur WhatsApp.`,
  )}
  image={pilotos}
  jsonLd={orgLd}
>
  <!-- Inicio: el Funko personalizado manda. El dibujo de la caja cambia al elegir figuras y "Crear mi Funko" lleva a /funkos con esa caja -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__text" data-enter>
        <p class="hero__eyebrow">{t('Funkos personalizados', 'Custom Funkos', 'Funkos personnalisés')}</p>
        <h1 id="hero-h">{t('Tu Funko, con tu cara y su caja', 'Your Funko, with your face and its own box', 'Votre Funko, à votre image, avec sa boîte')}</h1>
        <p class="lead">{t(
          'Lo hacemos a partir de tus fotos: la persona, su ropa, su mascota y el texto de la caja. Elige qué va dentro y mira el precio.',
          'We make it from your photos: the person, their clothes, their pet and the text on the box. Choose what goes inside and see the price.',
          'Nous le réalisons à partir de vos photos : la personne, ses vêtements, son animal et le texte de la boîte. Choisissez le contenu et voyez le prix.',
        )}</p>
      </div>

      <figure class="hero__caja" aria-live="polite">
        <div class="hero__dibujo" data-hcaja set:html={svgCaja(1, 0, { l: C.l })} />
        <figcaption class="hero__resumen"><span data-hresumen>{resumenFunko(1, 0, C.l)}</span><strong class="precio" data-hprecio>{C.euros(precioFunko(1, 0))}</strong></figcaption>
      </figure>

      <form class="hero__config" data-hconfig data-url={C.ruta('/funkos')} action={C.ruta('/funkos')}>
        <fieldset class="hero__opcion">
          <legend>{t('Funkos normales', 'Regular Funkos', 'Funkos normaux')}</legend>
          <div class="chips">{[1, 2].map((n) => <label class="chip"><input type="radio" name="n" value={n} checked={n === 1} /><span>{n}</span></label>)}</div>
        </fieldset>
        <fieldset class="hero__opcion">
          <legend>{t('Pequeños', 'Small', 'Petits')} <span class="hero__hint">{t(`mascota, niño · +${ePequeno}`, `pet, child · +${ePequeno}`, `animal, enfant · +${ePequeno}`)}</span></legend>
          <div class="chips">{[0, 1, 2, 3].map((n) => <label class="chip"><input type="radio" name="s" value={n} checked={n === 0} /><span>{n}</span></label>)}</div>
        </fieldset>
        <div class="btn-row">
          <button class="btn" type="submit">{t('Crear mi Funko', 'Create my Funko', 'Créer mon Funko')}</button>
          <a class="btn btn--secondary" href={C.ruta('/catalogo')}>{t('Ver el catálogo', 'See the catalogue', 'Voir le catalogue')}</a>
        </div>
      </form>

      <a class="hero__tira" href={C.ruta('/funkos#encargos')}>
        <span class="hero__fotos">
          {tira.map((f) => <Picture src={f.src} alt="" formats={['avif', 'webp']} widths={[120, 240]} sizes="80px" loading="eager" />)}
        </span>
        <span class="hero__tira-txt">{t(`Mira los ${funkosHechos.length} Funkos que ya hemos hecho`, `See the ${funkosHechos.length} Funkos we've already made`, `Voir les ${funkosHechos.length} Funkos déjà réalisés`)} <Icon name="flecha" /></span>
      </a>
    </div>
  </section>

  <section class="section cats" aria-labelledby="cats-h">
    <div class="wrap">
      <div class="section-head section-head--row">
        <h2 id="cats-h">{t('Compra por categoría', 'Shop by category', 'Acheter par catégorie')}</h2>
        <a class="link" href={C.ruta('/catalogo')}>{t('Todo el catálogo', 'Full catalogue', 'Tout le catalogue')} <Icon name="flecha" /></a>
      </div>
      <ul class="cats__grid">
        {C.categorias.map((c, i) => {
          // Funkos enseña el dibujo de la caja con un Funko (el modelo del Funko personalizado), no un encargo real
          const esFunkos = c.slug === 'funkos';
          const pf = C.producto(c.portada);
          const f = pf ? foto(pf) : null;
          const desde = c.enlace ? null : C.desdeCategoria(c.slug);
          const n = c.enlace ? null : C.deCategoria(c.slug).length;
          const desdeTxt = desde != null ? ` · ${t('desde', 'from', 'dès')} ${C.euros(desde)}` : '';
          return (
            <li class:list={['cat-tile', { 'cat-tile--grande': i < 3, 'cat-tile--dibujo': esFunkos }]}>
              {esFunkos
                ? <div class="cat-tile__caja" aria-hidden="true" set:html={svgCaja(1, 0, { l: C.l })} />
                : f && <Picture src={f.src} alt="" formats={['avif', 'webp']} widths={[320, 480, 720]} sizes={i < 2 ? '(min-width: 768px) 46vw, 92vw' : '(min-width: 768px) 30vw, 46vw'} loading="lazy" />}
              <div class="cat-tile__txt">
                <h3><a href={C.urlCategoria(c)}>{c.nombre}</a></h3>
                <p class="num">{esFunkos ? `${t('Desde', 'From', 'À partir de')} ${eBase}` : c.enlace ? t('Tu idea, con precio', 'Your idea, with a price', 'Votre idée, avec un prix') : `${n} ${n === 1 ? t('pieza', 'item', 'pièce') : t('piezas', 'items', 'pièces')}${desdeTxt}`}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="dest-h">
    <div class="wrap">
      <div class="section-head section-head--row">
        <h2 id="dest-h">{t('Lo que más se pide', 'Most popular', 'Les plus demandés')}</h2>
        <a class="link" href={C.ruta('/catalogo')}>{t(`Ver las ${C.productos.length} piezas`, `See all ${C.productos.length} items`, `Voir les ${C.productos.length} pièces`)} <Icon name="flecha" /></a>
      </div>
      <ul class="grid-productos grid-productos--4">
        {destacados.map((p) => <li><ProductCard p={p} /></li>)}
      </ul>
    </div>
  </section>

  <section class="section" id="como-funciona" style="--h: 2" data-moment="pinned-chapters" aria-labelledby="como-h">
    <div class="wrap mo-pc__grid">
      <div class="mo-pc__text">
        <h2 id="como-h">{t('Así se pide una pieza', 'How to order a piece', 'Comment commander une pièce')}</h2>
        <ol class="mo-pc__steps">
          <li class="mo-pc__step">
            <h3>{t('Elige', 'Choose', 'Choisissez')}</h3>
            <p>{t('Busca en el catálogo o trae tu idea. Cada ficha enseña la pieza real desde varios ángulos, con su precio.', 'Browse the catalogue or bring your own idea. Every product page shows the real piece from several angles, with its price.', 'Parcourez le catalogue ou apportez votre idée. Chaque fiche montre la vraie pièce sous plusieurs angles, avec son prix.')}</p>
            <figure class="mo-pc__visual"><Picture src={pilotos} alt={t('Las tres figuras de pilotos juntas', 'The three driver figures together', 'Les trois figurines de pilotes ensemble')} formats={['avif', 'webp']} widths={[480, 750]} sizes="(min-width: 1024px) 45vw, 92vw" loading="lazy" /></figure>
          </li>
          <li class="mo-pc__step">
            <h3>{t('Personaliza', 'Personalise', 'Personnalisez')}</h3>
            <p>{t('Nombre, mascota, tamaño, el texto de la caja. Escríbelo en la ficha y mándanos las fotos por WhatsApp.', 'Name, pet, size, the text on the box. Write it on the product page and send us the photos on WhatsApp.', "Prénom, animal, taille, texte de la boîte. Indiquez-le sur la fiche et envoyez-nous les photos sur WhatsApp.")}</p>
            <figure class="mo-pc__visual"><Picture src={posavasos.src} alt={posavasos.alt} formats={['avif', 'webp']} widths={[480, 750]} sizes="(min-width: 1024px) 45vw, 92vw" loading="lazy" /></figure>
          </li>
          <li class="mo-pc__step">
            <h3>{t('Recibe', 'Receive', 'Recevez')}</h3>
            <p>{t('Te confirmamos precio, envío y plazo antes de empezar. Se imprime bajo pedido y te llega a casa.', "We confirm the price, shipping and lead time before we start. It's printed to order and delivered to your door.", "Nous vous confirmons le prix, la livraison et le délai avant de commencer. La pièce est imprimée sur commande et livrée chez vous.")}</p>
            <figure class="mo-pc__visual"><Picture src={funkoDetalle.src} alt={funkoDetalle.alt} formats={['avif', 'webp']} widths={[480, 750]} sizes="(min-width: 1024px) 45vw, 92vw" loading="lazy" /></figure>
          </li>
        </ol>
      </div>
      <div class="mo-pc__visuals"></div>
    </div>
  </section>

  <section class="section cierre" aria-labelledby="cierre-h">
    <div class="wrap cierre__grid">
      <div class="cierre__text">
        <h2 id="cierre-h" class="cierre__word">{t('¿Tienes una idea?', 'Got an idea?', 'Une idée ?')}</h2>
        <p class="lead">{t(
          'Una estantería de tu serie, la tarjeta de tu negocio con NFC, una pieza rota que ya no venden. Cuéntanos qué necesitas, con un archivo STL o una foto, y te damos precio.',
          "A shelf for your favourite show, an NFC card for your business, a broken part you can't buy any more. Tell us what you need, with an STL file or a photo, and we'll give you a price.",
          "Une étagère de votre série préférée, une carte NFC pour votre commerce, une pièce cassée qui ne se vend plus. Dites-nous ce qu'il vous faut, avec un fichier STL ou une photo, et nous vous donnons un prix.",
        )}</p>
        <div class="btn-row">
          <a class="btn" href={C.ruta('/encargos')}>{t('Pedir un encargo a medida', 'Request a custom order', 'Demander une pièce sur mesure')}</a>
          <a class="btn btn--secondary" href={enlaceWhatsApp(t('¡Hola! Tengo una idea para un encargo a medida.', 'Hi! I have an idea for a custom order.', "Bonjour ! J'ai une idée de pièce sur mesure."))} target="_blank" rel="noopener"><WhatsAppIcon />{t('Contarlo por WhatsApp', 'Tell us on WhatsApp', 'En parler sur WhatsApp')}</a>
        </div>
      </div>
      <figure class="cierre__media"><Picture src={estanteria.src} alt={estanteria.alt} formats={['avif', 'webp']} widths={[400, 600, 750]} sizes="(min-width: 1024px) 34vw, 92vw" loading="lazy" /></figure>
    </div>
  </section>

  <Fragment slot="head">
    <script is:inline>document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
    <link rel="modulepreload" href="/kit/moments/moments.js" />
    <link rel="modulepreload" href="/kit/moments/lib.js" />
    <script is:inline type="module" src="/kit/moments/moments.js"></script>
  </Fragment>
</Base>

<script>
  import { FUNKO, precioFunko, resumenFunko, svgCaja } from '../lib/funko';
  import { euros } from '../scripts/cesta';
  import { idiomaDocumento } from '../i18n';
  // Mini configurador del inicio: dibuja la caja, enseña el precio y "Crear mi Funko" abre /funkos?n=&s= con esa caja
  const form = document.querySelector<HTMLFormElement>('[data-hconfig]');
  if (form) {
    const l = idiomaDocumento();
    const caja = document.querySelector<HTMLElement>('[data-hcaja]')!;
    const resumen = document.querySelector<HTMLElement>('[data-hresumen]')!;
    const precio = document.querySelector<HTMLElement>('[data-hprecio]')!;
    const pequenos = [...form.querySelectorAll<HTMLInputElement>('input[name="s"]')];
    let prevN = 1, prevS = 0;
    const pintar = () => {
      const fd = new FormData(form);
      const n = Number(fd.get('n') ?? 1);
      let s = Number(fd.get('s') ?? 0);
      const max = FUNKO.maxPequenos(n);
      pequenos.forEach((r) => (r.disabled = Number(r.value) > max));
      if (s > max) { s = max; pequenos.forEach((r) => (r.checked = Number(r.value) === s)); }
      caja.innerHTML = svgCaja(n, s, { nuevasN: Math.max(0, n - prevN), nuevasS: Math.max(0, s - prevS), l });
      prevN = n; prevS = s;
      resumen.textContent = resumenFunko(n, s, l);
      precio.textContent = euros(precioFunko(n, s));
    };
    form.addEventListener('change', pintar);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      location.href = `${form.dataset.url}?n=${fd.get('n') ?? 1}&s=${fd.get('s') ?? 0}`;
    });
  }
</script>

<style>
  /* ---- Hero: Funko protagonista ---- */
  .hero { padding-block: var(--s-6) var(--s-8); }
  .hero__grid { display: grid; gap: var(--s-5); grid-template-areas: "texto" "caja" "config" "tira"; }
  .hero__text { grid-area: texto; display: grid; gap: var(--s-4); justify-items: start; }
  .hero__eyebrow { font-weight: 600; color: var(--accent); }
  .hero h1 { max-width: 11ch; }
  .hero__caja { grid-area: caja; margin: 0; display: grid; gap: var(--s-4); padding: var(--s-6) var(--s-5) var(--s-5); border-radius: var(--r-lg); background: var(--surface); }
  .hero__dibujo { display: grid; place-items: center; height: clamp(170px, 42vw, 340px); }
  .hero__dibujo :global(svg.fk-svg) { display: block; width: auto; max-width: 100%; height: 100%; overflow: visible; }
  .hero__dibujo :global(.fk-marco) { fill: var(--accent); }
  .hero__dibujo :global(.fk-ventana) { fill: #f7f3ec; }
  .hero__dibujo :global(.fk-claro) { fill: #dfe8df; }
  .hero__dibujo :global(.fk-fig rect) { fill: var(--ink); }
  .hero__dibujo :global(.fk-eye) { fill: #f7f3ec; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__dibujo :global(.fk-new) { animation: entra 380ms var(--ease-out) both; }
  }
  @keyframes entra { from { opacity: 0; translate: 0 8px; } }
  .hero__resumen { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); font-weight: 560; }
  .hero__resumen strong { font-family: var(--font-display); font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1; }
  .hero__config { grid-area: config; display: grid; gap: var(--s-4); }
  .hero__opcion { border: 0; padding: 0; margin: 0; display: grid; gap: var(--s-2); }
  .hero__opcion legend { font-weight: 560; margin-bottom: var(--s-2); padding: 0; }
  .hero__hint { font-weight: 400; color: var(--muted); font-size: var(--t-small); }
  .hero__config .btn-row { margin-top: var(--s-2); }
  .hero__tira { grid-area: tira; display: flex; align-items: center; gap: var(--s-4); text-decoration: none; justify-self: start; padding-block: 6px; }
  .hero__fotos { display: flex; flex: none; }
  .hero__fotos :global(img) { display: block; width: 52px; height: 52px; object-fit: cover; border-radius: 50%; border: 3px solid var(--bg); margin-left: -14px; transition: transform 240ms var(--ease-out); }
  .hero__fotos :global(picture:first-child img) { margin-left: 0; }
  .hero__tira-txt { display: inline-flex; align-items: center; gap: 6px; font-weight: 560; font-size: 0.9375rem; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: text-decoration-color 200ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .hero__tira:hover .hero__tira-txt { text-decoration-color: currentColor; }
    .hero__tira:hover :global(img) { transform: translateY(-2px); }
  }
  @media (min-width: 1024px) {
    .hero { padding-block: var(--s-7) var(--s-9); }
    .hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); grid-template-areas: "texto caja" "config caja" "tira caja"; column-gap: var(--s-8); row-gap: var(--s-6); align-items: start; }
    .hero__text { align-self: end; }
    .hero__caja { padding: var(--s-8) var(--s-7) var(--s-6); align-self: center; }
    .hero__dibujo { height: 360px; }
  }

  /* ---- Categorías ---- */
  .cats__grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  .cat-tile { position: relative; border-radius: var(--r-lg); overflow: hidden; background: var(--surface); aspect-ratio: 4 / 5; isolation: isolate; }
  .cat-tile--grande { grid-column: span 2; aspect-ratio: 16 / 10; }
  .cat-tile :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease-out); z-index: -1; }
  .cat-tile::after { content: ""; position: absolute; inset: 35% 0 0; background: linear-gradient(rgb(20 22 18 / 0), rgb(20 22 18 / 0.55) 45%, rgb(20 22 18 / 0.86)); z-index: -1; pointer-events: none; }
  .cat-tile__txt { text-shadow: 0 1px 12px rgb(0 0 0 / 0.35); }
  .cat-tile__txt { position: absolute; inset: auto 0 0 0; padding: var(--s-4); color: #fff; display: grid; gap: 2px; }
  .cat-tile h3 { font-size: clamp(1.25rem, 1rem + 1vw, 1.875rem); }
  .cat-tile h3 a { text-decoration: none; }
  .cat-tile h3 a::after { content: ""; position: absolute; inset: 0; }
  .cat-tile p { font-size: var(--t-small); font-weight: 500; color: rgb(255 255 255 / 0.88); }
  .cat-tile:has(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .cat-tile a:focus-visible { outline-color: #fff; }
  @media (hover: hover) and (pointer: fine) { .cat-tile:hover :global(img) { transform: scale(1.03); } }
  /* Funkos: el dibujo de la caja entero, encima del texto, sin el degradado oscuro de las fotos */
  .cat-tile--dibujo { background: var(--surface); }
  .cat-tile__caja { position: absolute; inset: var(--s-5) var(--s-5) 92px; display: grid; place-items: center; z-index: -1; transition: transform 500ms var(--ease-out); }
  .cat-tile__caja :global(svg) { display: block; width: auto; height: 100%; max-width: 100%; }
  .cat-tile__caja :global(.fk-marco) { fill: var(--accent); }
  .cat-tile__caja :global(.fk-ventana) { fill: #f7f3ec; }
  .cat-tile__caja :global(.fk-claro) { fill: #dfe8df; }
  .cat-tile__caja :global(.fk-fig rect) { fill: var(--ink); }
  .cat-tile__caja :global(.fk-eye) { fill: #f7f3ec; }
  @media (hover: hover) and (pointer: fine) { .cat-tile--dibujo:hover .cat-tile__caja { transform: scale(1.03); } }
  .cat-tile--dibujo::after { display: none; }
  .cat-tile--dibujo .cat-tile__txt { color: var(--ink); text-shadow: none; }
  .cat-tile--dibujo p { color: var(--muted); }
  .cat-tile--dibujo a:focus-visible { outline-color: var(--accent); }
  @media (min-width: 768px) {
    /* 3 grandes arriba + 4 pequeñas debajo */
    .cats__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-4); }
    .cat-tile { grid-column: span 3; aspect-ratio: 4 / 5; }
    .cat-tile--grande { grid-column: span 4; aspect-ratio: 4 / 4.2; }
    .cat-tile__txt { padding: var(--s-5); }
  }

  /* ---- Cómo funciona (pinned-chapters de taste) ---- */
  #como-funciona :global(.mo-pc__step) { border-left-width: 1px; }
  #como-funciona :global(.mo-pc__step h3) { font-family: var(--font-display); font-size: 1.75rem; letter-spacing: -0.03em; font-weight: 450; }
  #como-funciona :global(.mo-pc__visual img) { object-position: 50% 50%; }
  /* Las fotos son verticales: el marco compartido también (el del kit es 4:3 y cortaba las cabezas) */
  #como-funciona:global(.is-live) :global(.mo-pc__visuals) { aspect-ratio: 4 / 5; width: auto; height: min(680px, calc(100svh - 160px)); justify-self: center; border-radius: var(--r-lg); overflow: hidden; }

  /* ---- Cierre ---- */
  .cierre { background: var(--surface); }
  .cierre__grid { display: grid; gap: var(--s-7); align-items: center; }
  .cierre__text { display: grid; gap: var(--s-5); justify-items: start; }
  .cierre .lead { color: var(--ink); }
