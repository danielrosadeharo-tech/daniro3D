---
// "¿No lo encuentras?": el cliente busca un modelo en MakerWorld, nos pega el enlace y le damos precio.
// Se guarda como un encargo más (panel /admin, aviso al móvil y "Mi cuenta"); si Firebase falla, sale por WhatsApp.
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { sitio, catalogoEn } from '../lib/catalogo';
import { migasLd } from '../lib/seo';
import { buscarEnMakerWorld } from '../lib/makerworld';
import { idiomaDe } from '../i18n';
const l = idiomaDe(Astro.url);
const C = catalogoEn(l);
const t = C.t;
const titulo = t('¿No encuentras lo que buscas?', "Can't find what you're looking for?", 'Vous ne trouvez pas votre bonheur ?');
const migas = [{ nombre: t('Inicio', 'Home', 'Accueil'), url: C.ruta('/') }, { nombre: t('¿No lo encuentras?', "Can't find it?", 'Introuvable ?'), url: C.ruta('/makerworld') }];
const conFirebase = Boolean(import.meta.env.PUBLIC_FIREBASE_API_KEY && import.meta.env.PUBLIC_FIREBASE_PROJECT_ID);
const opcional = t('(opcional)', '(optional)', '(facultatif)');
---
<Base
  title={t('Imprimimos tu modelo de MakerWorld', 'We print your MakerWorld model', 'Nous imprimons votre modèle MakerWorld')}
  description={t(
    'Si no está en el catálogo, búscalo en MakerWorld: elige entre miles de modelos 3D, mándanos el enlace y te damos precio para imprimirlo.',
    "If it's not in the catalogue, find it on MakerWorld: choose from thousands of 3D models, send us the link and we'll give you a price to print it.",
    "S'il n'est pas dans le catalogue, cherchez-le sur MakerWorld : choisissez parmi des milliers de modèles 3D, envoyez-nous le lien et nous vous donnons un prix pour l'imprimer.",
  )}
  activo="/makerworld"
  jsonLd={migasLd(migas)}
>
  <div class="wrap page-head">
    <Migas items={migas} />
    <h1>{titulo}</h1>
    <p class="lead">{t(
      'En MakerWorld hay miles de modelos 3D listos para imprimir: figuras, decoración, juguetes, soportes, regalos… Encuentra el que te guste, mándanos el enlace y te lo imprimimos.',
      'MakerWorld has thousands of 3D models ready to print: figures, decor, toys, stands, gifts… Find the one you like, send us the link and we\'ll print it for you.',
      'MakerWorld propose des milliers de modèles 3D prêts à imprimer : figurines, déco, jouets, supports, cadeaux… Trouvez celui qui vous plaît, envoyez-nous le lien et nous l\'imprimons pour vous.',
    )}</p>
  </div>

  <div class="wrap mw">
    <!-- Pasos: buscar, copiar, pegar -->
    <ol class="mw__pasos">
      <li>
        <span class="mw__n" aria-hidden="true">1</span>
        <div>
          <h2>{t('Búscalo en MakerWorld', 'Find it on MakerWorld', 'Trouvez-le sur MakerWorld')}</h2>
          <form class="mw__buscar" action={buscarEnMakerWorld('', l).split('?')[0]} method="get" target="_blank" data-buscar-mw>
            <label class="sr-only" for="mw-q">{t('Qué quieres buscar en MakerWorld', 'What to search for on MakerWorld', 'Que chercher sur MakerWorld')}</label>
            <span class="mw__lupa" aria-hidden="true"><Icon name="buscar" size={20} /></span>
            <input class="input" id="mw-q" name="keyword" type="search" enterkeyhint="search" placeholder={t('Ej.: dragón articulado, maceta, soporte de móvil', 'E.g.: articulated dragon, plant pot, phone stand', 'Ex. : dragon articulé, pot de fleurs, support de téléphone')} />
            <button class="btn" type="submit">{t('Buscar', 'Search', 'Rechercher')}</button>
          </form>
          <p class="hint">{t('Se abre MakerWorld en otra pestaña. También puedes', 'MakerWorld opens in a new tab. You can also', "MakerWorld s'ouvre dans un nouvel onglet. Vous pouvez aussi")} <a href={`https://makerworld.com/${l}`} target="_blank" rel="noopener">{t('entrar directamente', 'go straight there', 'y aller directement')} <Icon name="flecha" size={14} /></a></p>
        </div>
      </li>
      <li>
        <span class="mw__n" aria-hidden="true">2</span>
        <div>
          <h2>{t('Copia el enlace del modelo', "Copy the model's link", 'Copiez le lien du modèle')}</h2>
          <p>{t(
            'Abre el modelo que te guste y copia la dirección de arriba del navegador. En la app de MakerWorld: botón Compartir → Copiar enlace.',
            "Open the model you like and copy the address from the top of your browser. In the MakerWorld app: Share button → Copy link.",
            "Ouvrez le modèle qui vous plaît et copiez l'adresse en haut du navigateur. Dans l'application MakerWorld : bouton Partager → Copier le lien.",
          )}</p>
        </div>
      </li>
      <li>
        <span class="mw__n" aria-hidden="true">3</span>
        <div>
          <h2>{t('Pégalo aquí y te damos precio', "Paste it here and we'll give you a price", 'Collez-le ici et nous vous donnons un prix')}</h2>
          <p>{t(
            'Dinos el tamaño y el color, y te contestamos con precio y plazo. Sin compromiso: no pagas nada hasta que lo confirmes.',
            "Tell us the size and colour, and we'll reply with a price and lead time. No obligation: you don't pay anything until you confirm.",
            "Indiquez-nous la taille et la couleur, et nous vous répondons avec le prix et le délai. Sans engagement : vous ne payez rien avant d'avoir confirmé.",
          )}</p>
        </div>
      </li>
    </ol>

    <form class="mw__form" data-mw novalidate>
      <h2>{t('Mándanos el enlace', 'Send us the link', 'Envoyez-nous le lien')}</h2>
      <div class="field" data-campo="enlace">
        <label for="mw-enlace">{t('Enlace del modelo de MakerWorld', 'MakerWorld model link', 'Lien du modèle MakerWorld')}</label>
        <input class="input" id="mw-enlace" name="enlace" type="url" inputmode="url" autocomplete="off" required aria-describedby="mw-enlace-err mw-enlace-ok" placeholder="https://makerworld.com/es/models/…" />
        <p class="mw__detectado" id="mw-enlace-ok" data-detectado hidden></p>
        <p class="error" id="mw-enlace-err" aria-live="polite"></p>
      </div>
      <div class="grid2">
        <div class="field">
          <label for="mw-tam">{t('Tamaño aproximado', 'Approximate size', 'Taille approximative')} <span class="hint">{opcional}</span></label>
          <input class="input" id="mw-tam" name="tamano" placeholder={t('Ej.: 15 cm de alto', 'E.g.: 15 cm tall', 'Ex. : 15 cm de haut')} />
        </div>
        <div class="field">
          <label for="mw-color">{t('Color o colores', 'Colour(s)', 'Couleur(s)')} <span class="hint">{opcional}</span></label>
          <input class="input" id="mw-color" name="color" placeholder={t('Ej.: verde y negro', 'E.g.: green and black', 'Ex. : vert et noir')} />
        </div>
      </div>
      <div class="field">
        <label for="mw-notas">{t('Algo más', 'Anything else', 'Autre chose')} <span class="hint">{opcional}</span></label>
        <textarea class="textarea" id="mw-notas" name="notas" rows="3" placeholder={t('Cantidad, para cuándo lo necesitas, si es un regalo…', 'Quantity, when you need it, whether it\'s a gift…', 'Quantité, pour quand vous en avez besoin, si c\'est un cadeau…')}></textarea>
      </div>
      <div class="grid2">
        <div class="field" data-campo="nombre">
          <label for="mw-nombre">{t('Nombre', 'Name', 'Nom')}</label>
          <input class="input" id="mw-nombre" name="nombre" autocomplete="name" required aria-describedby="mw-nombre-err" />
          <p class="error" id="mw-nombre-err" aria-live="polite"></p>
        </div>
        <div class="field" data-campo="contacto">
          <label for="mw-contacto">{t('Teléfono o email', 'Phone or email', 'Téléphone ou e-mail')}</label>
          <input class="input" id="mw-contacto" name="contacto" autocomplete="email" required aria-describedby="mw-contacto-err" />
          <p class="error" id="mw-contacto-err" aria-live="polite"></p>
        </div>
      </div>
      <div class="field" data-campo="privacidad">
        <label class="check"><input type="checkbox" name="privacidad" required aria-describedby="mw-priv-err" /><span>{t('He leído la', 'I have read the', "J'ai lu la")} <a href={C.ruta('/privacidad')}>{t('política de privacidad', 'privacy policy', 'politique de confidentialité')}</a> {t('y acepto que uséis mis datos para responder a esta petición.', 'and agree to my details being used to reply to this request.', "et j'accepte que mes données soient utilisées pour répondre à cette demande.")}</span></label>
        <p class="error" id="mw-priv-err" aria-live="polite"></p>
      </div>
      <button class="btn btn--block" type="submit" data-enviar>
        {conFirebase ? t('Pedir presupuesto', 'Ask for a quote', 'Demander un devis') : <><WhatsAppIcon />{t('Enviar por WhatsApp', 'Send on WhatsApp', 'Envoyer sur WhatsApp')}</>}
      </button>
      <p class="nota">{t(
        'Los modelos son de sus autores en MakerWorld. Antes de imprimirlo comprobamos que la licencia del modelo lo permite.',
        "Models belong to their authors on MakerWorld. Before printing, we check that the model's licence allows it.",
        "Les modèles appartiennent à leurs auteurs sur MakerWorld. Avant l'impression, nous vérifions que la licence du modèle le permet.",
      )}</p>
      <p class="ok" role="status" data-ok hidden></p>
    </form>
  </div>

  <section class="section mw-otros" aria-labelledby="otros-h">
    <div class="wrap mw-otros__fila">
      <h2 id="otros-h">{t('¿Tienes tu propio archivo o una idea?', 'Have your own file or an idea?', 'Vous avez votre propre fichier ou une idée ?')}</h2>
      <p>{t('Mándanos el STL o una foto y lo hacemos a medida.', "Send us the STL or a photo and we'll make it to measure.", 'Envoyez-nous le STL ou une photo et nous le réalisons sur mesure.')}</p>
      <a class="btn btn--secondary" href={C.ruta('/encargos')}>{t('Pedir un encargo a medida', 'Request a custom order', 'Demander une pièce sur mesure')}</a>
    </div>
  </section>
</Base>

<style>
  .mw { display: grid; gap: var(--s-7); padding-bottom: var(--s-8); align-items: start; }
  @media (min-width: 900px) { .mw { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--s-8); } }
  .mw__pasos { list-style: none; padding: 0; display: grid; }
  .mw__pasos > li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-4); padding-block: var(--s-5); border-top: 1px solid var(--line); }
  .mw__pasos > li:last-child { border-bottom: 1px solid var(--line); }
  .mw__pasos h2 { font-size: 1.25rem; margin-bottom: var(--s-2); }
  .mw__pasos p { color: var(--muted); }
  .mw__n { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .mw__buscar { position: relative; display: flex; gap: var(--s-2); margin-block: var(--s-3) var(--s-2); }
  .mw__buscar .input { flex: 1; min-width: 0; padding-left: 44px; }
  .mw__lupa { position: absolute; left: 14px; top: 50%; translate: 0 -50%; color: var(--muted); display: inline-flex; pointer-events: none; }
  .mw__buscar .btn { flex: none; }
  .hint { font-size: var(--t-small); color: var(--muted); }
  .hint a { display: inline-flex; align-items: center; gap: 4px; }
  .mw__form { display: grid; gap: var(--s-4); padding: var(--s-5); border-radius: var(--r-lg); background: var(--card); }
  @media (min-width: 768px) { .mw__form { padding: var(--s-6); } }
  .mw__form h2 { font-size: 1.75rem; }
  .mw__detectado { font-size: var(--t-small); color: var(--accent); font-weight: 560; }
  .grid2 { display: grid; gap: var(--s-4); }
  @media (min-width: 600px) { .grid2 { grid-template-columns: 1fr 1fr; } }
  .check { display: flex; gap: 12px; align-items: flex-start; font-weight: 400 !important; line-height: 1.5; cursor: pointer; }
  .check input { width: 20px; height: 20px; margin-top: 2px; flex: none; }
  .ok { font-weight: 560; color: var(--accent); }
  .nota { font-size: var(--t-small); color: var(--muted); }
  .mw-otros { background: var(--surface); }
  .mw-otros__fila { display: grid; gap: var(--s-3); justify-items: start; }
  .mw-otros h2 { font-size: 1.5rem; }
</style>

<script>
  import sitio from '../data/sitio.json';
  import { firebaseActivo, mensajeError } from '../lib/firebase';
  import { guardarEncargo, referencia, avisarPedido } from '../lib/pedido/guardar';
  import { leerEnlaceMakerWorld, esDeMakerWorld } from '../lib/makerworld';
  import { idiomaDocumento, traductor } from '../i18n';
  const tr = traductor(idiomaDocumento());

  const form = document.querySelector<HTMLFormElement>('[data-mw]')!;
  const enlace = form.querySelector<HTMLInputElement>('#mw-enlace')!;
  const detectado = form.querySelector<HTMLElement>('[data-detectado]')!;

  const err = (campo: string, msg: string) => {
    const f = form.querySelector<HTMLElement>(`[data-campo="${campo}"]`)!;
    f.toggleAttribute('data-error', Boolean(msg));
    f.querySelector('.error')!.textContent = msg;
    f.querySelector('input, textarea')!.setAttribute('aria-invalid', String(Boolean(msg)));
  };
  const errorEnlace = (v: string) => !v
    ? tr('Pega aquí el enlace del modelo.', "Paste the model's link here.", 'Collez ici le lien du modèle.')
    : esDeMakerWorld(v)
      ? tr('Ese enlace no es de un modelo. Abre el modelo en MakerWorld y copia su dirección (contiene /models/).', "That link isn't a model. Open the model on MakerWorld and copy its address (it contains /models/).", "Ce lien n'est pas celui d'un modèle. Ouvrez le modèle sur MakerWorld et copiez son adresse (elle contient /models/).")
      : tr('Tiene que ser un enlace de makerworld.com.', 'It has to be a makerworld.com link.', 'Il doit s\'agir d\'un lien makerworld.com.');

  // Al pegar, se limpia el enlace (vale el texto entero de "Compartir") y se enseña qué modelo es
  function revisar(mostrarError = false) {
    const m = leerEnlaceMakerWorld(enlace.value);
    if (m) {
      enlace.value = m.url;
      detectado.hidden = false;
      detectado.textContent = `✓ ${tr('Modelo', 'Model', 'Modèle')} #${m.id}${m.nombre ? ` · ${m.nombre}` : ''}`;
      err('enlace', '');
    } else {
      detectado.hidden = true;
      if (mostrarError || enlace.value.trim()) err('enlace', errorEnlace(enlace.value.trim()));
    }
    return m;
  }
  enlace.addEventListener('paste', () => setTimeout(() => revisar(true), 0));
  enlace.addEventListener('change', () => revisar());

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const modelo = revisar(true);
    const nombre = String(fd.get('nombre') ?? '').trim();
    const contacto = String(fd.get('contacto') ?? '').trim();
    err('nombre', nombre ? '' : tr('Escribe tu nombre.', 'Enter your name.', 'Indiquez votre nom.'));
    err('contacto', /\d{9}/.test(contacto.replace(/\D/g, '')) || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contacto) ? '' : tr('Pon un teléfono de 9 cifras o un email para poder contestarte.', 'Enter a phone number or an email so we can reply.', 'Indiquez un numéro de téléphone ou un e-mail pour que nous puissions vous répondre.'));
    err('privacidad', fd.get('privacidad') ? '' : tr('Necesitamos tu permiso para usar estos datos y responderte.', 'We need your permission to use these details and reply to you.', 'Nous avons besoin de votre accord pour utiliser ces données et vous répondre.'));
    const primero = form.querySelector<HTMLElement>('[aria-invalid="true"]');
    if (!modelo || primero) { (primero ?? enlace).focus(); return; }

    const tamano = String(fd.get('tamano') ?? '').trim();
    const color = String(fd.get('color') ?? '').trim();
    const notas = String(fd.get('notas') ?? '').trim();
    // El encargo te llega en español en el panel, con el enlace limpio del modelo
    const descripcion = [
      `Modelo de MakerWorld: ${modelo.url}`,
      color && `Color: ${color}`,
      notas && `Notas: ${notas}`,
    ].filter(Boolean).join('\n');

    const ok = form.querySelector<HTMLElement>('[data-ok]')!;
    const btn = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
    const porWhatsApp = () => {
      const texto = [
        tr('¡Hola! Me gustaría que me imprimierais este modelo de MakerWorld:', "Hi! I'd like you to print this MakerWorld model for me:", "Bonjour ! J'aimerais que vous m'imprimiez ce modèle MakerWorld :"),
        modelo.url, '',
        tamano && `${tr('Tamaño', 'Size', 'Taille')}: ${tamano}`,
        color && `${tr('Color', 'Colour', 'Couleur')}: ${color}`,
        notas && `${tr('Notas', 'Notes', 'Remarques')}: ${notas}`,
        '', `${tr('Nombre', 'Name', 'Nom')}: ${nombre}`, `${tr('Contacto', 'Contact', 'Contact')}: ${contacto}`,
      ].filter((x) => x !== false && x !== undefined).join('\n').replace(/\n{3,}/g, '\n\n');
      const url = `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(texto)}`;
      const w = window.open(url, '_blank');
      if (w) w.opener = null; else location.href = url; // el navegador bloqueó la pestaña nueva
    };
    const hecho = () => { form.reset(); detectado.hidden = true; ok.hidden = false; ok.style.color = ''; };

    if (firebaseActivo) {
      btn.disabled = true; const txt = btn.innerHTML; btn.textContent = tr('Enviando…', 'Sending…', 'Envoi…');
      try {
        const r = await guardarEncargo({ descripcion, medidas: tamano.slice(0, 200), nombre, contacto, archivo: null });
        const ref = referencia(r!.id);
        avisarPedido('encargos', r!.id);
        hecho();
        ok.textContent = tr(
          `Petición ${ref} recibida. Miramos el modelo y te contestamos con precio y plazo.`,
          `Request ${ref} received. We'll look at the model and reply with a price and lead time.`,
          `Demande ${ref} reçue. Nous regardons le modèle et vous répondons avec le prix et le délai.`,
        );
      } catch (e2) {
        // No se pudo guardar en la web: la petición no se pierde, sale por WhatsApp
        console.warn('No se pudo guardar la petición en Firestore', mensajeError(e2));
        porWhatsApp();
        hecho();
        ok.textContent = tr('Te abrimos WhatsApp con tu petición escrita. Solo falta pulsar enviar.', "We've opened WhatsApp with your request already written. Just tap send.", "Nous avons ouvert WhatsApp avec votre demande déjà rédigée. Il ne reste qu'à appuyer sur envoyer.");
      } finally { btn.disabled = false; btn.innerHTML = txt; }
      return;
    }
    porWhatsApp();
    hecho();
    ok.textContent = tr('Te abrimos WhatsApp con tu petición escrita. Solo falta pulsar enviar.', "We've opened WhatsApp with your request already written. Just tap send.", "Nous avons ouvert WhatsApp avec votre demande déjà rédigée. Il ne reste qu'à appuyer sur envoyer.");
  });
</script>
