---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Icon from '../components/Icon.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import CarruselFunkos from '../components/CarruselFunkos.astro';
import { producto, ejemplos, foto, fotosDe, euros, enlaceWhatsApp, categoria } from '../lib/catalogo';
import { FUNKO, precioFunko, resumenFunko, leerComposicion, svgCaja, svgFigura } from '../lib/funko';
import { migasLd, productoLd } from '../lib/seo';

const p = producto('funko-personalizado')!;
const cat = categoria('funkos')!;
const migas = [{ nombre: 'Inicio', url: '/' }, { nombre: 'Funkos', url: '/funkos' }];
const cabecera = foto(producto('perruno-17')!, 0);
const miniatura = (await getImage({ src: foto(p).src, width: 144, format: 'webp' })).src;
const ldImgs = await Promise.all(fotosDe(p).map((f) => getImage({ src: f.src, width: 750, format: 'jpg' }).then((r) => r.src)));

// Galería de encargos hechos: todas las fotos de cada uno, para el visor
const hechos = await Promise.all(ejemplos.map(async (e) => {
  const comp = leerComposicion(e.composicion);
  const fotos = await Promise.all(fotosDe(e).map(async (f) => ({ src: (await getImage({ src: f.src, width: 750, format: 'webp', quality: 86 })).src, alt: f.alt })));
  return { e, comp, fotos, portada: foto(e) };
}));

const opciones = [{ n: 1, s: 3 }, { n: 2, s: 1 }];
const datos = { slug: p.slug, nombre: p.nombre, url: '/funkos', imagen: miniatura };
---
<Base
  title="Funko personalizado con tu foto y su caja, desde 55 €"
  description="Crea tu Funko personalizado a partir de tus fotos, con caja a medida. Caja + Funko normal 55 €; +20 € por pequeño y +30 € por normal. Mira los Funkos que ya hemos hecho."
  image={cabecera.src}
  activo="/funkos"
  jsonLd={[productoLd(p, ldImgs), migasLd(migas)]}
>
  <header class="wrap fk-head">
    <div class="fk-head__text" data-enter>
      <Migas items={migas} />
      <h1>Funkos personalizados con su caja</h1>
      <p class="lead">{cat.descripcion.replace(' Desde 55 €.', '')} Eliges cuántas figuras van dentro y el precio sale solo.</p>
      <p class="fk-head__facts">Desde <span class="num">{euros(FUNKO.base)}</span> · <span class="num">{ejemplos.length}</span> encargos hechos para ver</p>
    </div>
    <!-- Carrusel con los Funkos ya hechos (la portada de cada encargo); cada foto abre el visor -->
    <CarruselFunkos class="fk-head__media" etiqueta="Funkos que ya hemos hecho" visor eager
      sizes="(min-width: 768px) 34vw, 100vw"
      items={hechos.map(({ e, portada }) => ({ nombre: e.nombre.replace('Funko ', ''), src: portada.src, alt: portada.alt }))} />
  </header>

  <div class="wrap fk-tabs-wrap">
    <div class="fk-tabs" role="tablist" aria-label="Funkos" data-tabs>
      <button type="button" role="tab" id="tab-personaliza" aria-controls="personaliza" aria-selected="true" data-tab="personaliza">Personaliza tu Funko</button>
      <button type="button" role="tab" id="tab-encargos" aria-controls="encargos" aria-selected="false" tabindex="-1" data-tab="encargos">Encargos hechos <span class="fk-tabs__n num">{ejemplos.length}</span></button>
    </div>
  </div>

  <!-- ============ PESTAÑA 1: PERSONALIZA ============ -->
  <section class="wrap fk-panel" id="personaliza" role="tabpanel" aria-labelledby="tab-personaliza" data-panel="personaliza">
    <div class="fk-grid">
      <!-- Configurador -->
      <form class="fk-config" data-config novalidate aria-labelledby="config-h">
        <script type="application/json" data-producto set:html={JSON.stringify(datos)} />
        <h2 id="config-h">Configura tu caja</h2>
        <div class="fk-preview" aria-live="polite">
          <div class="fk-preview__caja" data-caja set:html={svgCaja(1, 0)} />
          <p class="fk-preview__txt"><span data-resumen>{resumenFunko(1, 0)}</span><strong class="precio" data-precio>{euros(precioFunko(1, 0))}</strong></p>
          <p class="fk-plazo">Plazo de elaboración: <strong>mínimo 2 semanas</strong>, al ser un pedido personalizado.</p>
        </div>

        <fieldset class="opcion">
          <legend>Funkos de tamaño normal <span class="opcion__hint">personas · el segundo suma {euros(FUNKO.normalExtra)}</span></legend>
          <div class="chips">
            {[1, 2].map((n) => <label class="chip"><input type="radio" name="normales" value={n} checked={n === 1} /><span>{n}</span></label>)}
          </div>
        </fieldset>
        <fieldset class="opcion">
          <legend>Funkos pequeños <span class="opcion__hint">mascotas, niños, objetos · +{euros(FUNKO.pequeno)} cada uno</span></legend>
          <div class="chips">
            {[0, 1, 2, 3].map((n) => <label class="chip"><input type="radio" name="pequenos" value={n} checked={n === 0} /><span>{n}</span></label>)}
          </div>
          <p class="opcion__hint" data-aviso-max hidden>Con 2 normales cabe 1 pequeño como máximo.</p>
        </fieldset>

        <div class="field">
          <label for="fk-pers">Cuéntanos quién va dentro <span class="opcion__hint">(opcional)</span></label>
          <textarea class="textarea" id="fk-pers" name="personalizacion" rows="3" maxlength="400" placeholder="Ej.: mi hermana con gafas y su gato gris; ella con la camiseta del Betis"></textarea>
          <p class="hint">Las fotos nos las mandas por WhatsApp al confirmar el pedido.</p>
        </div>

        <div class="comprar">
          <div class="qty" role="group" aria-label="Número de cajas">
            <button type="button" data-q="-1" aria-label="Una caja menos"><Icon name="menos" size={16} /></button>
            <output data-cantidad aria-live="polite">1</output>
            <button type="button" data-q="1" aria-label="Una caja más"><Icon name="mas" size={16} /></button>
          </div>
          <button class="btn comprar__main" type="submit"><Icon name="cesta" />Añadir a la cesta</button>
        </div>
        <a class="btn btn--secondary btn--block" href={enlaceWhatsApp('¡Hola! Quiero un Funko personalizado.')} target="_blank" rel="noopener" data-wa><WhatsAppIcon />Pedirlo por WhatsApp</a>
        <p class="nota">Se hace bajo pedido y tarda como mínimo 2 semanas. Sin pago en la web: te confirmamos los detalles y la fecha antes de imprimir.</p>
      </form>

      <!-- Guía de precios (la misma del catálogo) -->
      <div class="fk-guia">
        <h2>Guía de precios</h2>

        <section class="paso" aria-labelledby="p1">
          <h3 id="p1"><span class="paso__n" aria-hidden="true">1</span>Elementos del pedido</h3>
          <ul class="elementos">
            <li><span class="elementos__l" aria-hidden="true">A</span><div class="elementos__img" set:html={svgCaja(0, 0, { titulo: 'Caja' })} /><strong>Caja</strong><span>A medida, con tu texto</span></li>
            <li><span class="elementos__l" aria-hidden="true">B</span><div class="elementos__img" set:html={svgFigura('normal', 'Funko normal')} /><strong>Funko normal</strong><span>Tamaño estándar</span></li>
            <li><span class="elementos__l" aria-hidden="true">C</span><div class="elementos__img" set:html={svgFigura('pequeno', 'Funko pequeño')} /><strong>Funko pequeño</strong><span>Tamaño reducido</span></li>
          </ul>
        </section>

        <section class="paso" aria-labelledby="p2">
          <h3 id="p2"><span class="paso__n" aria-hidden="true">2</span>Precio base</h3>
          <div class="base">
            <div class="base__img" set:html={svgCaja(1, 0)} />
            <div class="base__txt">
              <strong>Caja + Funko normal</strong>
              <span>Incluye la caja personalizada y un Funko de tamaño normal.</span>
            </div>
            <span class="base__precio num">{euros(FUNKO.base)}</span>
          </div>
        </section>

        <section class="paso" aria-labelledby="p3">
          <h3 id="p3"><span class="paso__n" aria-hidden="true">3</span>Añadir más Funkos a la caja</h3>
          <ul class="extras">
            <li><div class="extras__img" set:html={svgFigura('pequeno', 'Funko pequeño')} /><div><strong>Funko pequeño</strong><span>Por cada uno que añadas</span></div><span class="extras__precio num">+{euros(FUNKO.pequeno)}</span></li>
            <li><div class="extras__img" set:html={svgFigura('normal', 'Funko normal')} /><div><strong>Funko normal</strong><span>Por cada uno que añadas</span></div><span class="extras__precio num">+{euros(FUNKO.normalExtra)}</span></li>
          </ul>
          <p class="hint">La caja aumenta de tamaño según el número de Funkos que incluyas.</p>
        </section>

        <section class="paso" aria-labelledby="p4">
          <h3 id="p4"><span class="paso__n" aria-hidden="true">4</span>Máximo por caja</h3>
          <p class="hint">En una misma caja cabe una de estas dos combinaciones:</p>
          <ul class="combos">
            {opciones.map((o, i) => (
              <li>
                <p class="combos__t"><strong>Opción {i + 1}</strong> {resumenFunko(o.n, o.s).replace('Caja + ', '')}</p>
                <div class="combos__img" set:html={svgCaja(o.n, o.s)} />
                <p class="combos__cuenta"><span>{euros(FUNKO.base)}{o.n > 1 && ` + ${euros(FUNKO.normalExtra)}`}{o.s > 0 && (o.s > 1 ? ` + ${o.s} × ${euros(FUNKO.pequeno)}` : ` + ${euros(FUNKO.pequeno)}`)} =</span><strong class="num">{euros(precioFunko(o.n, o.s))}</strong></p>
                <button type="button" class="btn btn--secondary btn--sm" data-preset={`${o.n},${o.s}`}>Configurar así</button>
              </li>
            ))}
          </ul>
        </section>

        <section class="paso" aria-labelledby="p5">
          <h3 id="p5">Qué necesitamos de ti</h3>
          <ul class="directrices">
            <li><strong>Fotos de cada persona:</strong> una de frente y otra de cuerpo entero, con buena luz y sin gafas de sol.</li>
            <li><strong>La ropa y los detalles:</strong> camiseta, peinado, gafas, gorra, un instrumento o lo que la haga reconocible.</li>
            <li><strong>Mascotas:</strong> una foto de frente y otra de lado, para acertar con el color y las manchas.</li>
            <li><strong>La caja:</strong> el nombre o texto, el número (#) y si quieres algún color o dibujo.</li>
            <li><strong>Con tiempo:</strong> cada Funko se modela y se pinta a mano para ti, así que tarda como mínimo 2 semanas. Si es para una fecha concreta, avísanos al pedirlo.</li>
            <li><strong>Cómo nos lo mandas:</strong> haz el pedido y envíanos las fotos por WhatsApp. Te confirmamos todo antes de imprimir.</li>
          </ul>
        </section>
      </div>
    </div>
  </section>

  <!-- ============ PESTAÑA 2: ENCARGOS HECHOS ============ -->
  <section class="wrap fk-panel" id="encargos" role="tabpanel" aria-labelledby="tab-encargos" data-panel="encargos">
    <div class="section-head">
      <h2>Funkos que ya hemos hecho</h2>
      <p>Son encargos de otros clientes y no están a la venta: sirven de ejemplo. Si te gusta uno, pide el tuyo con la misma composición.</p>
    </div>
    <ul class="grid-productos grid-productos--4 hechos">
      {hechos.map(({ e, comp, fotos, portada }, i) => (
        <li class="hecho">
          <button type="button" class="hecho__media" data-visor={i} aria-label={`Ver las ${fotos.length} fotos de ${e.nombre}`}>
            <Picture src={portada.src} alt={portada.alt} formats={['avif', 'webp']} widths={[240, 360, 480, 720]} sizes="(min-width: 1280px) 300px, (min-width: 768px) 30vw, 46vw" loading="lazy" />
            <span class="card__tag">Encargo hecho</span>
            <span class="hecho__n num" aria-hidden="true"><Icon name="zoom" size={16} />{fotos.length}</span>
          </button>
          <div class="card__body">
            <h3 class="card__title">{e.nombre.replace('Funko ', '')}</h3>
            <p class="card__cat">{e.composicion ?? 'Sin caja'}{comp && <> · <span class="num">{euros(precioFunko(comp.n, comp.s))}</span></>}</p>
          </div>
          {comp ? (
            <button type="button" class="link hecho__cta" data-preset={`${comp.n},${comp.s}`}>Quiero uno así <Icon name="flecha" /></button>
          ) : (
            <a class="link hecho__cta" href={enlaceWhatsApp(`¡Hola! Me gustaría un Funko como el de «${e.nombre}».`)} target="_blank" rel="noopener">Preguntar por uno así <Icon name="flecha" /></a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <!-- Visor de fotos: fuera de las pestañas para que se pueda abrir desde el carrusel aunque la pestaña esté oculta -->
  <dialog class="visor" data-visor-dlg aria-labelledby="visor-t">
      <div class="visor__bar">
        <p id="visor-t" class="visor__t"><span data-vtitulo></span> · <span class="num" data-vpos></span></p>
        <button type="button" class="icon-btn" data-vcerrar aria-label="Cerrar"><Icon name="cerrar" /></button>
      </div>
      <div class="visor__view"><img data-vimg alt="" /></div>
      <button type="button" class="visor__nav visor__nav--prev icon-btn" data-vprev aria-label="Foto anterior"><Icon name="izq" /></button>
      <button type="button" class="visor__nav visor__nav--next icon-btn" data-vnext aria-label="Foto siguiente"><Icon name="der" /></button>
      <script type="application/json" data-vdata set:html={JSON.stringify(hechos.map((h) => ({ nombre: h.e.nombre.replace('Funko ', ''), fotos: h.fotos })))} />
  </dialog>
</Base>

<style is:global>
  /* Dibujo de la caja y las figuras (también lo usa el configurador en vivo) */
  .fk-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .fk-svg .fk-marco { fill: var(--accent); }
  .fk-svg .fk-ventana { fill: #f7f3ec; }
  .fk-svg .fk-claro { fill: #dfe8df; }
  .fk-svg .fk-fig rect { fill: var(--ink); }
  .fk-svg .fk-eye { fill: #f7f3ec; }
  @media (prefers-reduced-motion: no-preference) {
    .fk-svg .fk-new { animation: fk-entra 380ms var(--ease-out) both; }
  }
  @keyframes fk-entra { from { opacity: 0; translate: 0 6px; } }
</style>

<style>
  .fk-head { display: grid; gap: var(--s-6); padding-block: var(--s-5) var(--s-6); align-items: end; }
  .fk-head__text { display: grid; gap: var(--s-4); }
  .fk-head h1 { font-size: clamp(2.5rem, 1.8rem + 3.4vw, 4.5rem); max-width: 13ch; }
  .fk-head__facts { font-weight: 560; }
  /* El carrusel es un componente: el tamaño se lo da la página con :global */
  .fk-head :global(.fk-head__media) { position: relative; border-radius: var(--r-lg); overflow: hidden; background: var(--surface); aspect-ratio: 4 / 4.4; min-width: 0; }
  @media (min-width: 768px) {
    .fk-head { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--s-7); }
    .fk-head :global(.fk-head__media) { max-height: 460px; }
  }

  /* Pestañas */
  .fk-tabs-wrap { position: sticky; top: var(--nav-h); z-index: 30; background: var(--bg); }
  .fk-tabs { display: flex; gap: var(--s-1); border-bottom: 1px solid var(--line-strong); overflow-x: auto; scrollbar-width: none; }
  .fk-tabs button {
    position: relative; display: inline-flex; align-items: center; gap: 8px; min-height: 52px; padding: 0 var(--s-4);
    border: 0; background: none; font-weight: 560; font-size: 1.0625rem; color: var(--muted); white-space: nowrap;
    transition: color 160ms ease;
  }
  .fk-tabs button::after { content: ""; position: absolute; left: var(--s-4); right: var(--s-4); bottom: -1px; height: 2px; background: var(--ink); transform: scaleX(0); transition: transform 240ms var(--ease-out); }
  .fk-tabs button[aria-selected="true"] { color: var(--ink); }
  .fk-tabs button[aria-selected="true"]::after { transform: scaleX(1); }
  .fk-tabs button:focus-visible { outline-offset: -4px; }
  @media (hover: hover) and (pointer: fine) { .fk-tabs button:hover { color: var(--ink); } }
  .fk-tabs__n { display: inline-grid; place-items: center; min-width: 24px; height: 22px; padding: 0 6px; border-radius: 11px; background: var(--surface); font-size: 0.8125rem; color: var(--ink); }

  .fk-panel { padding-block: var(--s-7) var(--s-9); }
  .fk-panel[hidden] { display: none; }
  .fk-panel:focus-visible { outline: none; }

  /* Configurador + guía */
  .fk-grid { display: grid; gap: var(--s-8); align-items: start; }
  @media (min-width: 1024px) {
    .fk-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr); gap: var(--s-8); }
    .fk-config { grid-column: 2; grid-row: 1; position: sticky; top: calc(var(--nav-h) + 76px); }
    .fk-guia { grid-column: 1; grid-row: 1; }
  }
  .fk-config { display: grid; gap: var(--s-5); padding: var(--s-5); border-radius: var(--r-lg); background: var(--card); box-shadow: var(--shadow-1); }
  @media (min-width: 768px) { .fk-config { padding: var(--s-6); } }
  .fk-config h2 { font-size: 1.75rem; }
  .fk-preview { display: grid; gap: var(--s-3); padding: var(--s-5); border-radius: var(--r-md); background: var(--bg); }
  .fk-preview__caja { display: grid; place-items: center; min-height: 150px; }
  .fk-preview__caja :global(svg.fk-svg) { width: auto; max-width: 100%; height: 150px; }
  .fk-preview__txt { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); font-weight: 560; }
  .fk-plazo { font-size: var(--t-small); color: var(--muted); }
  .fk-plazo strong { color: var(--ink); font-weight: 600; }
  .fk-preview__txt strong { font-family: var(--font-display); font-size: 2rem; font-weight: 500; letter-spacing: -0.02em; }
  .opcion { display: grid; gap: var(--s-3); }
  .opcion legend { font-weight: 560; margin-bottom: var(--s-3); }
  .opcion__hint { font-weight: 400; color: var(--muted); font-size: var(--t-small); }
  .comprar { display: flex; gap: var(--s-3); }
  .comprar .qty button { height: 46px; }
  .comprar__main { flex: 1; min-width: 0; padding-inline: var(--s-4); }
  .nota { font-size: var(--t-small); color: var(--muted); }
  .hint { font-size: var(--t-small); color: var(--muted); }

  .fk-guia { display: grid; gap: var(--s-7); }
  .fk-guia > h2 { font-size: var(--t-h2); }
  .paso { display: grid; gap: var(--s-4); }
  .paso h3 { display: flex; align-items: center; gap: var(--s-3); font-size: 1.5rem; }
  .paso__n { display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-family: var(--font-text); font-size: 0.9375rem; font-weight: 600; letter-spacing: 0; flex: none; }

  .elementos { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); }
  .elementos li { position: relative; display: grid; justify-items: center; align-content: end; gap: 2px; padding: var(--s-6) var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--surface); text-align: center; }
  .elementos__l { position: absolute; left: 10px; top: 10px; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-size: 0.75rem; font-weight: 600; }
  .elementos__img { height: 76px; display: grid; place-items: end center; margin-bottom: var(--s-3); }
  .elementos__img :global(svg.fk-svg) { width: auto; height: 76px; max-width: 100%; }
  .elementos li:nth-child(3) .elementos__img :global(svg.fk-svg) { height: 76px; }
  .elementos strong { font-weight: 600; }
  .elementos li > span:last-child { font-size: var(--t-small); color: var(--muted); }

  .base { display: grid; grid-template-columns: auto 1fr; gap: var(--s-4); align-items: center; padding: var(--s-5); border-radius: var(--r-md); background: var(--accent); color: var(--accent-ink); }
  .base__img { width: 92px; }
  .base__img :global(.fk-marco) { fill: #f7f3ec; }
  .base__img :global(.fk-ventana) { fill: var(--accent); }
  .base__img :global(.fk-claro) { fill: #c9d9cd; }
  .base__img :global(.fk-fig rect) { fill: #f7f3ec; }
  .base__img :global(.fk-eye) { fill: var(--accent); }
  .base__txt { display: grid; gap: 4px; }
  .base__txt strong { font-family: var(--font-display); font-size: 1.375rem; font-weight: 500; letter-spacing: -0.02em; }
  .base__txt span { color: #d7e3da; font-size: var(--t-small); }
  .base__precio { grid-column: 1 / -1; font-family: var(--font-display); font-size: 2.75rem; letter-spacing: -0.03em; line-height: 1; }
  @media (min-width: 560px) { .base { grid-template-columns: auto 1fr auto; } .base__precio { grid-column: auto; } }

  .extras { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  @media (min-width: 560px) { .extras { grid-template-columns: 1fr 1fr; } }
  .extras li { display: grid; grid-template-columns: 40px 1fr auto; gap: var(--s-3); align-items: center; padding: var(--s-4); border-radius: var(--r-md); background: var(--surface); }
  .extras__img { width: 36px; }
  .extras li div:nth-child(2) { display: grid; }
  .extras strong { font-weight: 600; }
  .extras li div span { font-size: var(--t-small); color: var(--muted); }
  .extras__precio { font-family: var(--font-display); font-size: 1.625rem; color: var(--accent); letter-spacing: -0.02em; }

  .combos { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  @media (min-width: 560px) { .combos { grid-template-columns: 1fr 1fr; } }
  .combos li { display: grid; gap: var(--s-3); padding: var(--s-4); border-radius: var(--r-md); background: var(--surface); align-content: start; }
  .combos__t strong { color: var(--accent); margin-right: 4px; }
  .combos__img { height: 128px; display: grid; place-items: center; }
  .combos__img :global(svg.fk-svg) { width: auto; max-width: 100%; height: 100%; max-height: 128px; }
  .combos__cuenta { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); font-size: var(--t-small); color: var(--muted); }
  .combos__cuenta strong { font-family: var(--font-display); font-size: 1.75rem; color: var(--ink); font-weight: 500; letter-spacing: -0.02em; }
  .btn--sm { min-height: 44px; padding-inline: var(--s-4); font-size: 0.9375rem; justify-self: start; }

  .directrices { list-style: none; padding: 0; display: grid; }
  .directrices li { padding-block: var(--s-4); border-top: 1px solid var(--line); line-height: 1.55; }
  .directrices li:last-child { border-bottom: 1px solid var(--line); }
  .directrices strong { font-weight: 600; }

  /* Encargos hechos */
  .hecho { display: grid; gap: var(--s-3); align-content: start; }
  .hecho__media { position: relative; display: block; width: 100%; padding: 0; border: 0; aspect-ratio: 3 / 4; border-radius: var(--r-md); overflow: hidden; background: var(--surface); cursor: zoom-in; transition: transform 240ms var(--ease-out), box-shadow 240ms var(--ease-out); }
  .hecho__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease-out); }
  .hecho__n { position: absolute; right: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: var(--r-pill); background: rgb(34 38 31 / 0.88); color: #fff; font-size: 0.8125rem; font-weight: 500; }
  .hecho__cta { justify-self: start; border: 0; background-color: transparent; color: var(--accent); padding: 0; min-height: 44px; font-size: 0.9375rem; }
  .card__tag { position: absolute; left: 10px; top: 10px; }
  @media (hover: hover) and (pointer: fine) {
    .hecho__media:hover { transform: translateY(-2px); box-shadow: var(--shadow-1); }
    .hecho__media:hover :global(img) { transform: scale(1.03); }
  }

  .visor { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #151713; color: #f2eee6;
    opacity: 0; transition: opacity 200ms ease, overlay 200ms allow-discrete, display 200ms allow-discrete; }
  .visor[open] { opacity: 1; }
  @starting-style { .visor[open] { opacity: 0; } }
  .visor::backdrop { background: #151713; }
  .visor__bar { position: absolute; inset: 0 0 auto; z-index: 2; display: flex; justify-content: space-between; align-items: center; padding: 8px 8px 8px 20px; }
  .visor__t { font-weight: 560; }
  .visor__bar .icon-btn, .visor__nav { color: #f2eee6; background: rgb(255 255 255 / 0.1); }
  .visor__view { position: absolute; inset: 64px 0 24px; display: grid; place-items: center; }
  .visor__view img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .visor__nav { position: absolute; top: 50%; translate: 0 -50%; z-index: 2; }
  .visor__nav--prev { left: 12px; } .visor__nav--next { right: 12px; }
  .visor :focus-visible { outline-color: #8cc0a8; }
</style>

<script>
  import { cesta, avisar, euros } from '../scripts/cesta';
  import { FUNKO, precioFunko, resumenFunko, svgCaja, urlCaja, imagenCaja } from '../lib/funko';
  import sitio from '../data/sitio.json';

  // ---- Pestañas (con #personaliza / #encargos en la URL) ----
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  function mostrar(id: string, { foco = false, url = true } = {}) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === id;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && foco) t.focus();
    });
    panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    if (url) history.replaceState(null, '', id === 'personaliza' ? location.pathname : `#${id}`);
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => mostrar(t.dataset.tab!));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { e.preventDefault(); mostrar(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, { foco: true }); }
    });
  });
  mostrar(location.hash === '#encargos' ? 'encargos' : 'personaliza', { url: false });
  addEventListener('hashchange', () => mostrar(location.hash === '#encargos' ? 'encargos' : 'personaliza', { url: false }));

  // ---- Configurador ----
  const form = document.querySelector<HTMLFormElement>('[data-config]')!;
  const d = JSON.parse(form.querySelector('[data-producto]')!.textContent!) as { slug: string; nombre: string; url: string; imagen: string };
  const caja = form.querySelector<HTMLElement>('[data-caja]')!;
  const resumen = form.querySelector<HTMLElement>('[data-resumen]')!;
  const precio = form.querySelector<HTMLElement>('[data-precio]')!;
  const out = form.querySelector<HTMLOutputElement>('[data-cantidad]')!;
  const avisoMax = form.querySelector<HTMLElement>('[data-aviso-max]')!;
  const wa = form.querySelector<HTMLAnchorElement>('[data-wa]')!;
  const radiosS = [...form.querySelectorAll<HTMLInputElement>('input[name="pequenos"]')];
  let cantidad = 1, prevN = 1, prevS = 0;

  const leer = () => ({ n: Number(new FormData(form).get('normales') ?? 1), s: Number(new FormData(form).get('pequenos') ?? 0) });
  function pintar() {
    let { n, s } = leer();
    const max = FUNKO.maxPequenos(n);
    radiosS.forEach((r) => (r.disabled = Number(r.value) > max));
    avisoMax.hidden = n < 2;
    if (s > max) { s = max; radiosS.forEach((r) => (r.checked = Number(r.value) === s)); }
    caja.innerHTML = svgCaja(n, s, { nuevasN: Math.max(0, n - prevN), nuevasS: Math.max(0, s - prevS) });
    prevN = n; prevS = s;
    const p = precioFunko(n, s);
    resumen.textContent = resumenFunko(n, s);
    precio.textContent = cantidad > 1 ? `${euros(p * cantidad)}` : euros(p);
    out.textContent = String(cantidad);
    form.querySelector<HTMLButtonElement>('[data-q="-1"]')!.disabled = cantidad <= 1;
    wa.href = `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(`¡Hola! Quiero un Funko personalizado: ${resumenFunko(n, s)} (${euros(p)}).`)}`;
  }
  form.addEventListener('change', pintar);
  form.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) => b.addEventListener('click', () => {
    cantidad = Math.max(1, Math.min(20, cantidad + Number(b.dataset.q))); pintar();
  }));
  function aplicarPreset(n: number, s: number) {
    form.querySelectorAll<HTMLInputElement>('input[name="normales"]').forEach((r) => (r.checked = Number(r.value) === n));
    radiosS.forEach((r) => (r.checked = Number(r.value) === s));
    pintar();
  }
  // "Configurar así" (guía) y "Quiero uno así" (encargos hechos)
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
    const [n, s] = b.dataset.preset!.split(',').map(Number);
    mostrar('personaliza');
    aplicarPreset(n, s);
    form.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    avisar(`Caja configurada: ${resumenFunko(n, s)}`);
  }));
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const { n, s } = leer();
    const fd = new FormData(form);
    const pers = String(fd.get('personalizacion') ?? '').trim();
    const opciones: Record<string, string> = { Composición: resumenFunko(n, s), Plazo: "mínimo 2 semanas" };
    // Enlace e imagen de esta composición: en WhatsApp se ve la caja con sus figuras
    cesta.añadir({ slug: d.slug, nombre: d.nombre, url: urlCaja(n, s), imagen: imagenCaja(n, s, true), opciones, personalizacion: pers || undefined, precio: precioFunko(n, s) }, cantidad);
    avisar('Funko añadido a la cesta', 'Ver cesta', () => document.dispatchEvent(new CustomEvent('cesta:abrir')));
  });
  pintar();
  // /funkos?n=1&s=2 (desde la página de cada caja) deja el configurador así
  const q = new URLSearchParams(location.search);
  if (q.has('n')) {
    const n = Number(q.get('n')), s = Number(q.get('s') ?? 0);
    if (n >= 1 && n <= FUNKO.maxNormales && s >= 0 && s <= FUNKO.maxPequenos(n)) aplicarPreset(n, s);
    history.replaceState(null, '', location.pathname + location.hash);
  }

  // ---- Visor de fotos de los encargos hechos ----
  const dlg = document.querySelector<HTMLDialogElement>('[data-visor-dlg]')!;
  const datos: { nombre: string; fotos: { src: string; alt: string }[] }[] = JSON.parse(dlg.querySelector('[data-vdata]')!.textContent!);
  const img = dlg.querySelector<HTMLImageElement>('[data-vimg]')!;
  let actual = 0, foto = 0, origen: HTMLElement | null = null;
  function verFoto(i: number) {
    const fs = datos[actual].fotos;
    foto = (i + fs.length) % fs.length;
    img.src = fs[foto].src; img.alt = fs[foto].alt;
    dlg.querySelector('[data-vtitulo]')!.textContent = datos[actual].nombre;
    dlg.querySelector('[data-vpos]')!.textContent = `${foto + 1} / ${fs.length}`;
    const varias = fs.length > 1;
    dlg.querySelectorAll<HTMLElement>('[data-vprev],[data-vnext]').forEach((b) => (b.hidden = !varias));
  }
  document.querySelectorAll<HTMLButtonElement>('[data-visor]').forEach((b) => b.addEventListener('click', () => {
    origen = b; actual = Number(b.dataset.visor); verFoto(0); dlg.showModal(); document.documentElement.style.overflow = 'hidden';
  }));
  dlg.querySelector('[data-vprev]')!.addEventListener('click', () => verFoto(foto - 1));
  dlg.querySelector('[data-vnext]')!.addEventListener('click', () => verFoto(foto + 1));
  dlg.querySelector('[data-vcerrar]')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') verFoto(foto + 1); if (e.key === 'ArrowLeft') verFoto(foto - 1); });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('close', () => { document.documentElement.style.overflow = ''; origen?.focus({ preventScroll: true }); document.dispatchEvent(new Event('carrusel:seguir')); });

  document.querySelectorAll('[data-visor]').forEach((b) => b.addEventListener('click', () => document.dispatchEvent(new Event('carrusel:parar'))));
</script>
