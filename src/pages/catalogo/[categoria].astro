---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Catalogo from '../../components/Catalogo.astro';
import Migas from '../../components/Migas.astro';
import { foto, catalogoEn, type Categoria } from '../../lib/catalogo';
import { migasLd, listaLd } from '../../lib/seo';
import { rutasCategoria } from '../../lib/rutas';
import { idiomaDe } from '../../i18n';

export const getStaticPaths = rutasCategoria;
const C = catalogoEn(idiomaDe(Astro.url));
const t = C.t;
const c = C.categoria((Astro.props as { c: Categoria }).c.slug)!;
const ps = C.deCategoria(c.slug);
const portada = C.producto(c.portada) ?? ps[0];
const f = foto(portada);
const desde = C.desdeCategoria(c.slug);
const migas = [{ nombre: t('Inicio', 'Home', 'Accueil'), url: C.ruta('/') }, { nombre: t('Catálogo', 'Catalogue', 'Catalogue'), url: C.ruta('/catalogo') }, { nombre: c.nombre, url: C.urlCategoria(c) }];
const desdeTxt = t('desde', 'from', 'dès');
---
<Base
  title={`${c.titulo}${desde != null ? ` ${desdeTxt} ${C.euros(desde)}` : ''}`}
  description={c.descripcion}
  image={f.src}
  activo={`/catalogo/${c.slug}`}
  jsonLd={[migasLd(migas), listaLd(c.titulo, ps, C.urlProducto)]}
>
  <header class="wrap cat-head">
    <div class="cat-head__text" data-enter>
      <Migas items={migas} />
      <h1>{c.titulo}</h1>
      <p class="lead">{c.descripcion}</p>
      <p class="cat-head__facts"><span class="num">{ps.length}</span> {t('piezas', 'items', 'pièces')}{desde != null && <> · {desdeTxt} <span class="num">{C.euros(desde)}</span></>}</p>
    </div>
    <div class="cat-head__media">
      <Picture src={f.src} alt={f.alt} formats={['avif', 'webp']} widths={[360, 540, 750]} sizes="(min-width: 768px) 34vw, 100vw" loading="eager" fetchpriority="high" />
    </div>
  </header>
  <div class="wrap" style="padding-bottom: var(--s-9)">
    <Catalogo productos={ps} categoriaFija={c.slug} />
  </div>
</Base>
<style>
  .cat-head { display: grid; gap: var(--s-6); padding-block: var(--s-5) var(--s-7); align-items: end; }
  .cat-head__text { display: grid; gap: var(--s-4); }
  .cat-head h1 { font-size: clamp(2.5rem, 1.8rem + 3.4vw, 4.5rem); max-width: 14ch; }
  .cat-head__facts { font-weight: 560; }
  .cat-head__media { border-radius: var(--r-lg); overflow: hidden; background: var(--surface); aspect-ratio: 16 / 10; }
  .cat-head__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; }
  @media (min-width: 768px) {
    .cat-head { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: var(--s-7); }
    .cat-head__media { aspect-ratio: 4 / 5; max-height: 460px; justify-self: end; width: 100%; }
  }
</style>
