---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import Icon from '../components/Icon.astro';
import { metodosDisponibles } from '../lib/pedido';
import sitio from '../data/sitio.json';
const metodos = metodosDisponibles();
---
<Base title="Tu cesta" description="Revisa tu pedido y envíalo por WhatsApp. Te confirmamos precio final, envío y plazo." noindex>
  <div class="wrap page-head">
    <Migas items={[{ nombre: 'Inicio', url: '/' }, { nombre: 'Cesta' }]} />
    <h1>Tu cesta</h1>
  </div>
  <div class="wrap checkout" data-checkout>
    <section class="checkout__lineas" aria-labelledby="lin-h">
      <h2 id="lin-h" class="sr-only">Piezas en la cesta</h2>
      <ul data-lineas style="list-style:none;padding:0"></ul>
      <div class="vacio" data-vacio hidden>
        <p class="lead">Tu cesta está vacía.</p>
        <a class="btn" href="/catalogo">Ver el catálogo</a>
      </div>
      <div class="vacio" data-hecho hidden>
        <p class="lead">¡Pedido listo!</p>
        <p data-hecho-msg role="status"></p>
        <p class="nota">Si no se ha abierto nada, escríbenos por WhatsApp al {sitio.telefonoVisible} y lo vemos.</p>
        <a class="btn btn--secondary" href="/catalogo">Seguir mirando el catálogo</a>
      </div>
      <div class="total checkout__total" data-con-lineas><span>Total</span><strong class="precio" data-total>0 €</strong></div>
      <p class="nota" data-nota-consulta hidden>Las piezas a consultar no suman: te damos su precio al confirmar.</p>
    </section>

    <section class="checkout__form" data-con-lineas aria-labelledby="datos-h">
      <form data-form-pedido novalidate>
        <h2 id="datos-h">Tus datos</h2>
        <div class="field" data-campo="nombre">
          <label for="c-nombre">Nombre</label>
          <input class="input" id="c-nombre" name="nombre" autocomplete="name" required aria-describedby="e-nombre" />
          <p class="error" id="e-nombre" aria-live="polite"></p>
        </div>
        <div class="field">
          <label for="c-tel">Teléfono <span class="hint">(opcional)</span></label>
          <input class="input" id="c-tel" name="telefono" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
        <div class="field" data-campo="email">
          <label for="c-email">Email <span class="hint">(opcional)</span></label>
          <input class="input" id="c-email" name="email" type="email" autocomplete="email" aria-describedby="e-email" />
          <p class="error" id="e-email" aria-live="polite"></p>
        </div>
        <div class="field">
          <label for="c-notas">Notas <span class="hint">(opcional)</span></label>
          <textarea class="textarea" id="c-notas" name="notas" rows="3" placeholder="Ciudad para el envío, fecha que te viene bien, dudas…"></textarea>
        </div>

        <fieldset class="metodos">
          <legend>Cómo nos mandas el pedido</legend>
          {metodos.map((m, i) => (
            <label class="metodo">
              <input type="radio" name="metodo" value={m.id} checked={i === 0} />
              <span><strong>{m.id === 'whatsapp' ? <WhatsAppIcon size={18} /> : <Icon name="correo" size={18} />}{m.etiqueta}</strong><small>{m.descripcion}</small></span>
            </label>
          ))}
        </fieldset>

        <button class="btn btn--block" type="submit" data-enviar>Enviar pedido</button>
        <p class="nota">No pagas nada todavía. Al recibir el pedido te confirmamos el precio final, el envío y el plazo, y acordamos el pago.</p>
      </form>
    </section>
  </div>
</Base>

<style>
  .checkout { display: grid; gap: var(--s-7); padding-bottom: var(--s-9); align-items: start; }
  @media (min-width: 900px) { .checkout { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--s-8); } .checkout__form { position: sticky; top: calc(var(--nav-h) + 24px); } }
  .checkout__total { padding-top: var(--s-4); margin-top: var(--s-2); border-top: 1px solid var(--line-strong); }
  .checkout__form form { display: grid; gap: var(--s-4); padding: var(--s-5); border-radius: var(--r-lg); background: var(--card); }
  @media (min-width: 768px) { .checkout__form form { padding: var(--s-6); } }
  .checkout__form h2 { font-size: 1.5rem; }
  .metodos { display: grid; gap: var(--s-2); }
  .metodos legend { margin-bottom: var(--s-2); }
  .metodo { display: flex; gap: var(--s-3); align-items: flex-start; padding: var(--s-3) var(--s-4); border: 1px solid var(--line-strong); border-radius: var(--r-md); cursor: pointer; transition: border-color 160ms ease; }
  .metodo:has(input:checked) { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
  .metodo input { margin-top: 5px; width: 18px; height: 18px; flex: none; }
  .metodo span { display: grid; gap: 2px; }
  .metodo strong { display: inline-flex; align-items: center; gap: 8px; font-weight: 560; }
  .metodo small { color: var(--muted); font-size: var(--t-small); line-height: 1.45; }
  .nota { font-size: var(--t-small); color: var(--muted); }
</style>

<script>
  import { cesta, htmlLineas, conectarLista, euros } from '../scripts/cesta';
  import { metodos, type Pedido } from '../lib/pedido';
  import { firebaseActivo, auth } from '../lib/firebase';
  import { guardarPedido, referencia } from '../lib/pedido/guardar';
  import { onAuthStateChanged } from 'firebase/auth';
  const root = document.querySelector<HTMLElement>('[data-checkout]')!;
  const ul = root.querySelector<HTMLElement>('[data-lineas]')!;
  const form = root.querySelector<HTMLFormElement>('[data-form-pedido]')!;
  conectarLista(ul);
  let enviado = false;

  function pintar() {
    const ls = cesta.lineas();
    ul.innerHTML = htmlLineas(ls);
    root.querySelector('[data-vacio]')!.toggleAttribute('hidden', ls.length > 0 || enviado);
    root.querySelector('[data-hecho]')!.toggleAttribute('hidden', ls.length > 0 || !enviado);
    root.querySelectorAll('[data-con-lineas]').forEach((el) => el.toggleAttribute('hidden', ls.length === 0));
    root.querySelector('[data-total]')!.textContent = euros(cesta.total());
    root.querySelector('[data-nota-consulta]')!.toggleAttribute('hidden', !cesta.hayConsultas());
  }
  pintar();
  document.addEventListener('cesta:cambio', pintar);

  // Si el cliente ha iniciado sesión, rellenamos su nombre y email
  if (firebaseActivo) onAuthStateChanged(auth(), (u) => {
    if (!u) return;
    const n = form.querySelector<HTMLInputElement>('#c-nombre')!, m = form.querySelector<HTMLInputElement>('#c-email')!;
    if (!n.value && u.displayName) n.value = u.displayName;
    if (!m.value && u.email) m.value = u.email;
  });

  const err = (campo: string, msg: string) => {
    const f = form.querySelector<HTMLElement>(`[data-campo="${campo}"]`)!;
    f.toggleAttribute('data-error', Boolean(msg));
    f.querySelector('.error')!.textContent = msg;
    f.querySelector('input')!.setAttribute('aria-invalid', String(Boolean(msg)));
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const nombre = String(fd.get('nombre') ?? '').trim();
    const email = String(fd.get('email') ?? '').trim();
    err('nombre', nombre ? '' : 'Escribe tu nombre para saber de quién es el pedido.');
    err('email', !email || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? '' : 'Este email no parece completo. Revisa que tenga @ y dominio.');
    const primero = form.querySelector<HTMLInputElement>('[aria-invalid="true"]');
    if (primero) { primero.focus(); return; }

    const metodo = metodos.find((m) => m.id === fd.get('metodo')) ?? metodos[0];
    const pedido = {
      lineas: cesta.lineas(),
      cliente: { nombre, telefono: String(fd.get('telefono') ?? '').trim() || undefined, email: email || undefined, notas: String(fd.get('notas') ?? '').trim() || undefined },
      total: cesta.total(),
      hayConsultas: cesta.hayConsultas(),
    };
    const btn = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
    // 1) Se guarda en Firestore (si está configurado) para que aparezca en el panel y en "Mi cuenta"
    let guardado = false;
    if (firebaseActivo) {
      btn.disabled = true; btn.textContent = 'Enviando…';
      try {
        const id = await guardarPedido(pedido, metodo.id);
        if (id) { (pedido as Pedido).referencia = referencia(id); guardado = true; }
      } catch (e) {
        console.warn('No se pudo guardar el pedido en Firestore', e); // seguimos por WhatsApp igualmente
      } finally { btn.disabled = false; btn.textContent = 'Enviar pedido'; }
    }
    // 2) Y se manda por WhatsApp o email, como siempre
    const r = await metodo.enviar(pedido);
    // El pedido ya va escrito en WhatsApp o en el correo: la cesta se vacía para el siguiente
    root.querySelector('[data-hecho-msg]')!.textContent = guardado ? `Pedido ${(pedido as Pedido).referencia} recibido. ${r.mensaje}` : r.mensaje;
    enviado = true;
    form.reset();
    cesta.vaciar();
    if (r.redirigirA) {
      if (r.redirigirA.startsWith('mailto:')) location.href = r.redirigirA;
      else {
        const w = window.open(r.redirigirA, '_blank');
        if (w) w.opener = null;
        else location.href = r.redirigirA; // el navegador bloqueó la pestaña nueva
      }
    }
  });
</script>
