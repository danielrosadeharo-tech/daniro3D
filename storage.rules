rules_version = '2';

// Reglas de Firebase Storage para Daniro 3D
// - productos/: fotos del catálogo. Las ve cualquiera (las descarga el build de Vercel); solo suben los administradores.
// - encargos/: archivo STL o foto que adjunta un cliente al pedir un encargo. Cualquiera puede subir UNO nuevo
//   (máx. 10 MB, sin sobrescribir); solo los administradores pueden verlos o borrarlos.

service firebase.storage {
  match /b/{bucket}/o {

    function esAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /productos/{slug}/{archivo} {
      allow read: if true;
      allow create, update: if esAdmin()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if esAdmin();
    }

    match /encargos/{encargoId}/{archivo} {
      allow create: if resource == null
        && request.resource.size < 10 * 1024 * 1024;
      allow read, delete: if esAdmin();
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
