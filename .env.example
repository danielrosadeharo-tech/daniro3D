# Copia este archivo como .env para probar en tu ordenador.
# En Vercel: Project → Settings → Environment Variables (las mismas seis).
# Los valores salen de Firebase Console → Configuración del proyecto → Tus apps → App web → firebaseConfig.
# Son públicos por diseño (van en el navegador); lo que protege los datos son las reglas de Firestore y Storage.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
