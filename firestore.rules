rules_version = '2';

// Reglas de Firestore para Daniro 3D
// - Catálogo (productos, categorías): lo lee cualquiera; solo lo escriben los administradores.
// - Pedidos y encargos: cualquiera puede CREAR uno (con o sin cuenta), con los campos validados.
//   Cada cliente con cuenta lee solo los suyos. Los administradores leen y cambian todos.
// - admins/{uid}: lista de administradores. Se crea a mano en la consola; nadie puede escribirla desde la web.
// - ajustes: solo administradores (aquí se guarda la URL del Deploy Hook de Vercel).

service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() { return request.auth != null; }
    function esAdmin() {
      return conSesion() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function esDueno() { return conSesion() && resource.data.uid == request.auth.uid; }
    // Al crear: el uid es el del usuario conectado, o null si pide sin cuenta
    function uidValido() {
      return (request.resource.data.uid == null)
          || (conSesion() && request.resource.data.uid == request.auth.uid);
    }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function estados() { return ['nuevo', 'confirmado', 'fabricando', 'enviado', 'entregado', 'cancelado']; }

    // ---------- Catálogo ----------
    match /productos/{slug} {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /categorias/{slug} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ---------- Pedidos ----------
    match /pedidos/{id} {
      allow create: if uidValido()
        && request.resource.data.keys().hasOnly(['uid', 'cliente', 'lineas', 'total', 'hayConsultas', 'metodo', 'estado', 'creado'])
        && request.resource.data.keys().hasAll(['uid', 'cliente', 'lineas', 'total', 'hayConsultas', 'metodo', 'estado', 'creado'])
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.creado == request.time
        && request.resource.data.cliente is map
        && texto(request.resource.data.cliente.nombre, 1, 80)
        && request.resource.data.cliente.keys().hasOnly(['nombre', 'telefono', 'email', 'notas'])
        && request.resource.data.lineas is list
        && request.resource.data.lineas.size() > 0
        && request.resource.data.lineas.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total < 100000
        && request.resource.data.hayConsultas is bool
        && request.resource.data.metodo in ['whatsapp', 'email', 'tarjeta'];

      allow read: if esAdmin() || esDueno();
      // El cliente no puede tocar su pedido; el administrador solo cambia el estado (y notas internas)
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'notasInternas'])
        && request.resource.data.estado in estados();
      allow delete: if esAdmin();
    }

    // ---------- Encargos a medida ----------
    match /encargos/{id} {
      allow create: if uidValido()
        && request.resource.data.keys().hasOnly(['uid', 'descripcion', 'medidas', 'nombre', 'contacto', 'archivo', 'estado', 'creado'])
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.creado == request.time
        && texto(request.resource.data.descripcion, 10, 3000)
        && texto(request.resource.data.medidas, 0, 200)
        && texto(request.resource.data.nombre, 1, 80)
        && texto(request.resource.data.contacto, 5, 120)
        && (request.resource.data.archivo == null || request.resource.data.archivo is map);

      allow read: if esAdmin() || esDueno();
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respuesta', 'notasInternas'])
        && request.resource.data.estado in estados();
      allow delete: if esAdmin();
    }

    // ---------- Administración ----------
    match /admins/{uid} {
      // Cada usuario puede comprobar si él mismo es admin; nadie escribe desde la web
      allow read: if conSesion() && request.auth.uid == uid;
      allow write: if false;
    }
    match /ajustes/{docId} {
      allow read, write: if esAdmin();
    }

    // Todo lo demás, cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
